<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:Arsenal.UI.Controls">

    <!-- Motion.

         One vocabulary for the whole theme, so nothing invents its own timing. Hover is
         the fastest thing on screen because the pointer is already there and any lag
         reads as the control being slow to notice. Opening a group is the slowest,
         because it is the only moment where the whole page changes and the eye needs to
         be told where the content came from.

         Decelerating eases throughout: motion that starts fast and settles reads as
         responsive, where an accelerating one reads as reluctant. -->
    <Duration x:Key="HoverDuration">0:0:0.09</Duration>
    <Duration x:Key="SelectDuration">0:0:0.16</Duration>
    <Duration x:Key="PageDuration">0:0:0.22</Duration>

    <CubicEase x:Key="OutEase" EasingMode="EaseOut"/>
    <QuarticEase x:Key="PageEase" EasingMode="EaseOut"/>

    <!--
        The Arsenal theme's own chrome.

        Merged onto the application's resources only while that theme is selected, and
        removed again when it is not - see App.ApplyThemeChrome. Everything in here is a
        replacement for a style the app already has, so it must be merged last: the
        winning entry for a key is the one merged latest.

        Colour is not in here. Colour is a palette, and the palette is applied to the same
        tokens for every theme. This file is the part a palette cannot express: different
        templates, different shapes, and settings that live one level down.
    -->

    <!-- =====================================================================
         Settings row.

         The stock row is a label on the left and its control on the right. This one
         adds a status rail down the left edge that lights when the row is hovered or
         its control has focus, which is what makes a long list scan as a console
         readout rather than a form.
         ===================================================================== -->

    <Style TargetType="{x:Type controls:SettingsRow}">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MinHeight" Value="{StaticResource RowMinHeight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsRow}">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- The rail. Always occupies its column so nothing shifts when
                             it lights; only its opacity changes. -->
                        <Rectangle x:Name="Rail" Grid.Column="0" Opacity="0"
                                   Fill="{DynamicResource AccentPrimary}"
                                   Margin="0,6" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="RailScale" ScaleY="0.2"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <Border x:Name="Hover" Grid.Column="1" Opacity="0"
                                Background="{DynamicResource SurfaceCardHover}"/>

                        <Grid Grid.Column="1" Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{TemplateBinding Header}"
                                           Style="{StaticResource SettingLabelStyle}"/>
                                <TextBlock Text="{TemplateBinding Description}"
                                           Style="{StaticResource SettingDescriptionStyle}"
                                           Visibility="{TemplateBinding Description, Converter={StaticResource HideWhenEmptyText}}"/>
                                <ContentPresenter ContentSource="ContentBelow" Margin="0,10,0,0"
                                                  Visibility="{TemplateBinding ContentBelow, Converter={StaticResource HideWhenNull}}"/>
                            </StackPanel>

                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Divider drawn at the top of the row rather than the bottom,
                             so the last row of a panel never leaves a line hanging above
                             the panel's own edge. -->
                        <Rectangle x:Name="Divider" Grid.Column="1" Height="1"
                                   VerticalAlignment="Top"
                                   Fill="{DynamicResource DividerBrush}"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowDivider" Value="True">
                            <Setter TargetName="Divider" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- The rail grows out of the row's centre rather than fading
                             in, so a pointer running down a list draws a line that
                             follows it instead of a column of blinking marks. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{StaticResource HoverDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="Rail"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{StaticResource HoverDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="RailScale"
                                                         Storyboard.TargetProperty="ScaleY" To="1"
                                                         Duration="{StaticResource SelectDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{StaticResource SelectDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="Rail"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{StaticResource SelectDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="RailScale"
                                                         Storyboard.TargetProperty="ScaleY" To="0.2"
                                                         Duration="{StaticResource SelectDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Keyboard focus lights the same rail, so tabbing through a
                             page tracks the same way the pointer does. -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Rail"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{StaticResource HoverDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="RailScale"
                                                         Storyboard.TargetProperty="ScaleY" To="1"
                                                         Duration="{StaticResource SelectDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Rail"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{StaticResource SelectDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="RailScale"
                                                         Storyboard.TargetProperty="ScaleY" To="0.2"
                                                         Duration="{StaticResource SelectDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =====================================================================
         Settings group.

         Two presentations in one template. Closed, the group is a pressable panel
         carrying its icon, title and description with a chevron: the page becomes a
         short list of destinations. Open, the same group shows a back bar and its rows,
         and its siblings are collapsed by the control, so the page reads as a subpage
         without any page having been navigated to.
         ===================================================================== -->

    <Style TargetType="{x:Type controls:SettingsGroup}">
        <Setter Property="DrillIn" Value="True"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsGroup}">
                    <Grid>
                        <!-- ===== Closed: the destination panel ===== -->
                        <controls:AngularBorder x:Name="Closed"
                                                Cut="12" Corners="TopRight,BottomLeft"
                                                Background="{DynamicResource SurfaceCard}"
                                                BorderBrush="{DynamicResource StrokeSubtle}"
                                                BorderThickness="{DynamicResource BorderWeight}"
                                                Padding="18,16"
                                                Cursor="Hand">
                            <controls:AngularBorder.RenderTransform>
                                <TranslateTransform x:Name="ClosedShift"/>
                            </controls:AngularBorder.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="{TemplateBinding Icon}"
                                               FontSize="22"
                                               Foreground="{DynamicResource AccentPrimary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"
                                               Visibility="{TemplateBinding Icon, Converter={StaticResource HideWhenNoIcon}}"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               FontFamily="{DynamicResource FontDisplay}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{TemplateBinding Description}"
                                               Style="{StaticResource SettingDescriptionStyle}"
                                               MaxWidth="640" HorizontalAlignment="Left"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{TemplateBinding Description, Converter={StaticResource HideWhenEmptyText}}"/>
                                </StackPanel>

                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextTertiary}"
                                               VerticalAlignment="Center">
                                    <ui:SymbolIcon.RenderTransform>
                                        <TranslateTransform x:Name="ChevronShift"/>
                                    </ui:SymbolIcon.RenderTransform>
                                </ui:SymbolIcon>
                            </Grid>
                        </controls:AngularBorder>

                        <!-- ===== Open: the subpage ===== -->
                        <StackPanel x:Name="Opened" Visibility="Collapsed">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="OpenedShift"/>
                            </StackPanel.RenderTransform>
                            <!-- The heading row, and whatever the page hangs off it.
                                 The back bar and the pinned heading are mutually
                                 exclusive, so they share a cell; only the visible one
                                 sizes the row. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- A drilled-into group states nothing about itself.
                                     Its name is in the title bar, after the page's, and
                                     its description has taken the page's description
                                     line; repeating either here would say the same thing
                                     three times down the left edge of the window. The
                                     way back is the title bar's back arrow, which is
                                     where every other way back in this application
                                     already is.

                                     A pinned group is not a subpage and keeps its own
                                     heading: nothing else on the page names it. -->
                                <StackPanel x:Name="PinnedHeader" Grid.Column="0" Visibility="Collapsed" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{TemplateBinding Icon}" FontSize="20"
                                                       Foreground="{DynamicResource AccentPrimary}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                                       Visibility="{TemplateBinding Icon, Converter={StaticResource HideWhenNoIcon}}"/>
                                        <TextBlock Text="{TemplateBinding Header}"
                                                   FontFamily="{DynamicResource FontDisplay}"
                                                   FontSize="19" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{TemplateBinding Description}"
                                               Style="{StaticResource SettingDescriptionStyle}"
                                               Margin="32,4,0,0" MaxWidth="720"
                                               HorizontalAlignment="Left"
                                               Visibility="{TemplateBinding Description, Converter={StaticResource HideWhenEmptyText}}"/>
                                </StackPanel>

                                <!-- Whatever the page put beside the heading. This
                                     template had no presenter for it at all, which is
                                     why Home's Edit controls and Reset buttons existed,
                                     bound correctly and were nowhere on screen in this
                                     theme: a template that never mentions a property
                                     does not fail, it silently drops it.

                                     Only on the open state, and deliberately. When a
                                     drill-in group is closed its whole card is the
                                     button that opens it, so a control placed inside
                                     that card could not be pressed without also
                                     drilling in. -->
                                <ContentPresenter x:Name="HeaderContentHost" Grid.Column="1"
                                                  Content="{TemplateBinding HeaderContent}"
                                                  Margin="16,0,0,12"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"/>
                            </Grid>

                            <controls:AngularBorder Cut="14" Corners="TopRight,BottomLeft"
                                                    Background="{DynamicResource SurfaceCard}"
                                                    BorderBrush="{DynamicResource StrokeSubtle}"
                                                    BorderThickness="{DynamicResource BorderWeight}">
                                <ItemsPresenter Margin="0,4"/>
                            </controls:AngularBorder>

                            <ContentPresenter x:Name="FooterHost"
                                              Content="{TemplateBinding Footer}"
                                              Margin="0,14,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- The panel leans toward the pointer and its chevron moves the
                             way pressing it will take the page.

                             Keyed on the group rather than on the panel inside it. As
                             SourceName="Closed" the setters below still ran - the card
                             lit up - but the storyboards did not, so the card changed
                             colour under the pointer and never moved, which is the half
                             of the gesture that says it leads somewhere. The row
                             template a few lines up animates a named transform the same
                             way and has always worked; the trigger there names no
                             source. While the group is closed it is nothing but this
                             panel, so hovering one is hovering the other, and while it
                             is open the panel is collapsed and has nothing to show. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Closed" Property="Background" Value="{DynamicResource SurfaceCardHover}"/>
                            <Setter TargetName="Closed" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ClosedShift"
                                                         Storyboard.TargetProperty="X" To="5"
                                                         Duration="{StaticResource SelectDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="ChevronShift"
                                                         Storyboard.TargetProperty="X" To="4"
                                                         Duration="{StaticResource SelectDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ClosedShift"
                                                         Storyboard.TargetProperty="X" To="0"
                                                         Duration="{StaticResource SelectDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="ChevronShift"
                                                         Storyboard.TargetProperty="X" To="0"
                                                         Duration="{StaticResource SelectDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Opening: the subpage arrives from the right, the direction
                             the chevron pointed, so the page reads as having moved
                             forward rather than swapped. -->
                        <Trigger Property="IsOpen" Value="True">
                            <Setter TargetName="Closed" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Opened" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OpenedShift"
                                                         Storyboard.TargetProperty="X" From="34" To="0"
                                                         Duration="{StaticResource PageDuration}"
                                                         EasingFunction="{StaticResource PageEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="Opened"
                                                         Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                         Duration="{StaticResource PageDuration}"
                                                         EasingFunction="{StaticResource PageEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <!-- Coming back the list falls in from the left, the
                                 opposite of the way it left. -->
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ClosedShift"
                                                         Storyboard.TargetProperty="X" From="-26" To="0"
                                                         Duration="{StaticResource PageDuration}"
                                                         EasingFunction="{StaticResource PageEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="Closed"
                                                         Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                         Duration="{StaticResource PageDuration}"
                                                         EasingFunction="{StaticResource PageEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="FooterHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Collapsed rather than left empty: an Auto column costs no
                             width with nothing in it, but its left margin does, and
                             every group without header content would carry the gap. -->
                        <Trigger Property="HeaderContent" Value="{x:Null}">
                            <Setter TargetName="HeaderContentHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Pinned by its page: the one control the page exists for is
                             not worth a click. Shown inline with no back bar, since
                             there is nothing to go back to. -->
                        <Trigger Property="AlwaysOpen" Value="True">
                            <Setter TargetName="Closed" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Opened" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PinnedHeader" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- A group with no title is not a destination - some pages use
                             one as a plain container - so it stays open and inline. -->
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="Closed" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Opened" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="Closed" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Opened" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =====================================================================
         Toggle.

         Not a pill. A hard slab with a travelling block and a lamp, so on and off are
         legible from the shape as well as the colour.
         ===================================================================== -->

    <Style TargetType="{x:Type ui:ToggleSwitch}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:ToggleSwitch}">
                    <Grid Background="Transparent">
                        <!-- Wider than it is tall, with the state written in it. A bare
                             block that slides tells you something changed but not which
                             way; the word does, and it is the part that survives being
                             read quickly or at a glance from across the desk. -->
                        <controls:AngularBorder x:Name="Track"
                                                Width="76" Height="30"
                                                Cut="8" Corners="TopRight,BottomLeft"
                                                ClipsContent="True"
                                                Background="{DynamicResource SurfaceSunken}"
                                                BorderBrush="{DynamicResource StrokeSubtle}"
                                                BorderThickness="{DynamicResource BorderWeight}">
                            <Grid>
                                <Rectangle x:Name="Wash" Fill="{DynamicResource AccentSubtle}" Opacity="0"/>

                                <TextBlock x:Name="StateText" Text="OFF"
                                           FontFamily="{DynamicResource FontDisplay}"
                                           FontSize="10.5" FontWeight="Bold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,11,0"
                                           Foreground="{DynamicResource TextTertiary}"/>

                                <Rectangle x:Name="Knob"
                                           Width="18" Height="18"
                                           HorizontalAlignment="Left"
                                           Margin="5,0,0,0"
                                           Fill="{DynamicResource TextTertiary}"/>
                            </Grid>
                        </controls:AngularBorder>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            <Setter TargetName="Track" Property="Effect" Value="{DynamicResource AccentGlow}"/>
                            <Setter TargetName="Wash" Property="Opacity" Value="1"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentPrimary}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,5,0"/>
                            <!-- The word swaps sides with the block, so the lit end is
                                 always the end the state is written at. -->
                            <Setter TargetName="StateText" Property="Text" Value="ON"/>
                            <Setter TargetName="StateText" Property="HorizontalAlignment" Value="Left"/>
                            <Setter TargetName="StateText" Property="Margin" Value="11,0,0,0"/>
                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource SurfaceCardHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =====================================================================
         Choice chip. Cut corners, a lit leading edge when chosen.

         A chip carries the accent on its outline whether or not it is chosen: at rest
         that outline is all it is, and choosing one fills it, lights its leading edge
         and lets it glow. So the accent marks what can be pressed and the fill marks
         what is pressed, rather than the outline having to do both jobs by changing
         colour. It also stops a row of unchosen chips reading as disabled, which a grey
         stroke on a near-black ground does.
         ===================================================================== -->

    <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="{StaticResource SegmentMinWidth}"/>
        <Setter Property="Margin" Value="{StaticResource ChipGap}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- Clipped: the lit leading edge runs the full height, and the
                         bottom-left corner is cut away, so without this the strip
                         hangs past the chamfer. -->
                    <controls:AngularBorder x:Name="Chrome"
                                            Cut="9" Corners="TopRight,BottomLeft"
                                            ClipsContent="True"
                                            Background="{DynamicResource SurfaceSunken}"
                                            BorderBrush="{DynamicResource AccentPrimary}"
                                            BorderThickness="{DynamicResource BorderWeight}">
                        <Grid>
                            <Rectangle x:Name="Edge" Width="3" HorizontalAlignment="Left"
                                       Opacity="0" Fill="{DynamicResource AccentPrimary}"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="EdgeScale" ScaleY="0.3"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </controls:AngularBorder>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceCardHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <!-- The lit edge unrolls from the middle of the chip, so choosing
                             one in a row reads as that one switching on rather than as
                             the whole row repainting. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSubtle}"/>
                            <Setter TargetName="Chrome" Property="Effect" Value="{DynamicResource AccentGlow}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Edge"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{StaticResource HoverDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="EdgeScale"
                                                         Storyboard.TargetProperty="ScaleY" To="1"
                                                         Duration="{StaticResource SelectDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Edge"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{StaticResource HoverDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="EdgeScale"
                                                         Storyboard.TargetProperty="ScaleY" To="0.3"
                                                         Duration="{StaticResource SelectDuration}"
                                                         EasingFunction="{StaticResource OutEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The row variant keeps the same face at the smaller size rows use. -->
    <Style x:Key="RowSegmentStyle" TargetType="RadioButton" BasedOn="{StaticResource SegmentedRadioButtonStyle}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- =====================================================================
         Action button. Cut corner, no fill until it is wanted.
         ===================================================================== -->

    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="{StaticResource InlineGap}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <controls:AngularBorder x:Name="Chrome"
                                            Cut="9" Corners="TopRight,BottomLeft"
                                            Background="{DynamicResource SurfaceSunken}"
                                            BorderBrush="{DynamicResource AccentPrimary}"
                                            BorderThickness="{DynamicResource BorderWeight}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </controls:AngularBorder>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceCardHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSubtle}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =====================================================================
         Freeform card and inset, cut to match the panels above.
         ===================================================================== -->

    <Style x:Key="CardSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource BorderWeight}"/>
        <!-- Restated, not inherited. A style that replaces another by key replaces it
             whole, so leaving this out did not fall back to the stock card's rounding -
             it fell back to a Border's own default of none, which is what squared the
             free-form cards on Home, Battery and the rest. This theme's only reason to
             override the card at all is the heavier border above. -->
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
        <Setter Property="Margin" Value="{StaticResource SectionGap}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

</ResourceDictionary>
