<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:Arsenal.UI.Controls"
                    xmlns:converters="clr-namespace:Arsenal.UI.Converters">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <converters:EmptyStringToCollapsedConverter x:Key="HideWhenEmptyText"/>
    <converters:EmptySymbolToCollapsedConverter x:Key="HideWhenNoIcon"/>
    <converters:NullToCollapsedConverter x:Key="HideWhenNull"/>
    <BooleanToVisibilityConverter x:Key="HideWhenFalse"/>

    <!-- ===================================================================
         SettingsRow - the single row primitive used by every settings page.

         Layout: [icon] [label + description] ......... [control]
                 optional full-width content underneath
         =================================================================== -->
    <Style TargetType="{x:Type controls:SettingsRow}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsRow}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Inset hairline; SettingsGroup decides which rows get one. -->
                        <Border Grid.Row="0" Height="1"
                                Background="{DynamicResource DividerBrush}"
                                SnapsToDevicePixels="True"
                                Visibility="{TemplateBinding ShowDivider, Converter={StaticResource HideWhenFalse}}"/>

                        <Grid x:Name="MainLine" Grid.Row="1" Margin="16,12,16,6" MinHeight="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="{TemplateBinding Icon}"
                                           FontSize="18"
                                           Margin="0,0,14,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Visibility="{TemplateBinding Icon, Converter={StaticResource HideWhenNoIcon}}"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{TemplateBinding Header}"
                                           Style="{StaticResource SettingLabelStyle}"
                                           VerticalAlignment="Top"
                                           Visibility="{TemplateBinding Header, Converter={StaticResource HideWhenEmptyText}}"/>
                                <TextBlock Text="{TemplateBinding Description}"
                                           Style="{StaticResource SettingDescriptionStyle}"
                                           Visibility="{TemplateBinding Description, Converter={StaticResource HideWhenEmptyText}}"/>
                            </StackPanel>

                            <ContentPresenter Grid.Column="2"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>

                        <ContentPresenter x:Name="BelowLine"
                                          Grid.Row="2"
                                          Content="{TemplateBinding ContentBelow}"
                                          Margin="16,0,16,14"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- No second line: the row is a plain control row, so it takes the
                             full comfortable height and symmetric padding. -->
                        <Trigger Property="ContentBelow" Value="{x:Null}">
                            <Setter TargetName="BelowLine" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MainLine" Property="Margin" Value="16,10,16,10"/>
                            <Setter TargetName="MainLine" Property="MinHeight" Value="{StaticResource RowMinHeight}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         SettingsGroup - a titled card wrapping a stack of SettingsRows.
         =================================================================== -->
    <Style TargetType="{x:Type controls:SettingsGroup}">
        <Setter Property="Margin" Value="{StaticResource SectionGap}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsGroup}">
                    <StackPanel>
                        <StackPanel x:Name="HeaderHost" Margin="2,0,2,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="HeaderTitleHost" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="{TemplateBinding Icon}"
                                                   Style="{StaticResource SectionIconStyle}"
                                                   Visibility="{TemplateBinding Icon, Converter={StaticResource HideWhenNoIcon}}"/>
                                    <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource SectionTitleStyle}"/>
                                </StackPanel>
                                <ContentPresenter x:Name="HeaderContentHost"
                                                  Grid.Column="1"
                                                  Content="{TemplateBinding HeaderContent}"
                                                  Margin="16,0,0,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{TemplateBinding Description}"
                                       Style="{StaticResource SettingDescriptionStyle}"
                                       Margin="0,5,0,0"
                                       MaxWidth="720"
                                       HorizontalAlignment="Left"
                                       Visibility="{TemplateBinding Description, Converter={StaticResource HideWhenEmptyText}}"/>
                        </StackPanel>

                        <Border Background="{DynamicResource SurfaceCard}"
                                BorderBrush="{DynamicResource StrokeSubtle}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusCard}"
                                SnapsToDevicePixels="True">
                            <ItemsPresenter/>
                        </Border>

                        <ContentPresenter x:Name="FooterHost"
                                          Content="{TemplateBinding Footer}"
                                          Margin="0,12,0,0"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="FooterHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HeaderContent" Value="{x:Null}">
                            <Setter TargetName="HeaderContentHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         ValueSlider - slider plus readout, one size everywhere.
         =================================================================== -->
    <Style TargetType="{x:Type controls:ValueSlider}">
        <Setter Property="Width" Value="{StaticResource SliderRowWidth}"/>
        <Setter Property="ReadoutWidth" Value="{StaticResource SliderReadoutWidth}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ValueSlider}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- In the track's own row, so it centres on the bar rather than
                             on the bar plus the scale beneath it. -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{TemplateBinding Header}"
                                   Width="{TemplateBinding HeaderWidth}"
                                   Margin="0,0,10,0"
                                   FontSize="13"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Visibility="{TemplateBinding Header, Converter={StaticResource HideWhenEmptyText}}"/>

                        <Slider x:Name="PART_Slider"
                                Grid.Row="0" Grid.Column="1"
                                VerticalAlignment="Center"
                                Minimum="{TemplateBinding Minimum}"
                                Maximum="{TemplateBinding Maximum}"
                                TickFrequency="{TemplateBinding TickFrequency}"
                                Ticks="{TemplateBinding Ticks}"
                                IsSnapToTickEnabled="{TemplateBinding IsSnapToTickEnabled}"
                                IsEnabled="{TemplateBinding IsEnabled}"
                                Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{TemplateBinding DisplayText}"
                                   Width="{TemplateBinding ReadoutWidth}"
                                   Margin="{TemplateBinding ReadoutMargin}"
                                   TextAlignment="Right"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>

                        <!-- Column 1 only: the scale belongs under the track, not under
                             the header or the readout. -->
                        <controls:SliderScale x:Name="Scale"
                                              Grid.Row="1" Grid.Column="1"
                                              Margin="{TemplateBinding ScaleMargin}"
                                              Minimum="{TemplateBinding Minimum}"
                                              Maximum="{TemplateBinding Maximum}"
                                              Marks="{TemplateBinding Marks}"
                                              Format="{TemplateBinding Format}"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowScale" Value="False">
                            <Setter TargetName="Scale" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         QuickTile - action-centre tile: toggle body plus optional chevron.
         =================================================================== -->
    <Style TargetType="{x:Type controls:QuickTile}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceCardHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="62"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:QuickTile}">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusControl}"
                                SnapsToDevicePixels="True"/>

                        <!-- Hover and checked states fade in over their own layers: a
                             trigger that swaps the brush outright pops, and these brushes
                             come from the theme so they cannot be animated directly. -->
                        <Border x:Name="HoverLayer"
                                Background="{DynamicResource SurfaceSelected}"
                                CornerRadius="{StaticResource RadiusControl}"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <Border x:Name="CheckedLayer"
                                Background="{DynamicResource AccentSubtle}"
                                BorderBrush="{DynamicResource AccentPrimary}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusControl}"
                                Opacity="0"
                                IsHitTestVisible="False"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon x:Name="Glyph"
                                           Grid.Column="0"
                                           Symbol="{TemplateBinding Icon}"
                                           Width="30"
                                           Height="30"
                                           FontSize="20"
                                           Margin="11,0,9,0"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>

                            <StackPanel x:Name="TileText" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="{TemplateBinding Label}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Text="{TemplateBinding State}"
                                           FontSize="11"
                                           Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Visibility="{TemplateBinding State, Converter={StaticResource HideWhenEmptyText}}"/>
                            </StackPanel>

                            <!-- Its own button so the chevron opens the list instead of
                                 toggling the tile underneath it. -->
                            <Border x:Name="ExpanderSeparator"
                                    Grid.Column="2"
                                    Width="1"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource StrokeSubtle}"
                                    IsHitTestVisible="False"/>

                            <Button x:Name="Expander"
                                    Grid.Column="3"
                                    Command="{TemplateBinding ExpandCommand}"
                                    CommandParameter="{TemplateBinding ExpandCommandParameter}"
                                    Width="38"
                                    Height="Auto"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Margin="0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Show all options">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ExpanderChrome"
                                                Background="Transparent"
                                                CornerRadius="0,5,5,0"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <!-- Opacity is animated instead of the theme brush itself,
                                                     keeping the hover smooth in both light and dark modes. -->
                                                <Border x:Name="ExpanderHoverTint"
                                                        Background="{DynamicResource AccentPrimary}"
                                                        CornerRadius="0,5,5,0"
                                                        Opacity="0"/>
                                                <ui:SymbolIcon x:Name="BaseChevron"
                                                               Symbol="ChevronRight24"
                                                               FontSize="13"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                <ui:SymbolIcon x:Name="AccentChevron"
                                                       Symbol="ChevronRight24"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentForeground}"
                                                       Opacity="0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ExpanderHoverTint"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.12"/>
                                                            <DoubleAnimation Storyboard.TargetName="BaseChevron"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.10"/>
                                                            <DoubleAnimation Storyboard.TargetName="AccentChevron"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.14"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ExpanderHoverTint"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.18"/>
                                                            <DoubleAnimation Storyboard.TargetName="BaseChevron"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.16"/>
                                                            <DoubleAnimation Storyboard.TargetName="AccentChevron"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.14"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ExpanderHoverTint" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Takes the tile off the grid. Occupies the chevron's place
                                 while editing, so the tile keeps its shape either way. -->
                            <Button x:Name="Remover"
                                    Grid.Column="3"
                                    Visibility="Collapsed"
                                    Command="{TemplateBinding RemoveCommand}"
                                    CommandParameter="{TemplateBinding RemoveCommandParameter}"
                                    Width="38"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Margin="0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Remove this tile">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="0,5,5,0" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Border x:Name="RemoverTint"
                                                        Background="{DynamicResource StatusCritical}"
                                                        CornerRadius="0,5,5,0"
                                                        Opacity="0"/>
                                                <ui:SymbolIcon Symbol="Subtract24"
                                                               FontSize="13"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RemoverTint" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ExpandCommand" Value="{x:Null}">
                            <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ExpanderSeparator" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckedLayer" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckedLayer" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- After the ExpandCommand trigger on purpose: while editing,
                             every tile shows the remove control, including the ones that
                             have no chevron of their own to give up. -->
                        <Trigger Property="IsEditing" Value="True">
                            <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Remover" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ExpanderSeparator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="1"/>
                            <Setter Property="ToolTip" Value="Choose what this tile controls"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         MetricTile - one dashboard readout.
         The 5px margin plus a -5px margin on the containing grid keeps the outer
         edges of the tile row flush with the rest of the page.
         =================================================================== -->
    <Style TargetType="{x:Type controls:MetricTile}">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:MetricTile}">
                    <Border Background="{DynamicResource SurfaceCard}"
                            BorderBrush="{DynamicResource StrokeSubtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusCard}"
                            Padding="16,14,16,16"
                            SnapsToDevicePixels="True">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{TemplateBinding Icon}"
                                               FontSize="15"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentPrimary}"
                                               Visibility="{TemplateBinding Icon, Converter={StaticResource HideWhenNoIcon}}"/>
                                <TextBlock Text="{TemplateBinding Label}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="{TemplateBinding Value}"
                                           FontSize="26"
                                           LineHeight="30"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{TemplateBinding SecondaryValue}"
                                           FontSize="14"
                                           Margin="8,0,0,3"
                                           VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Visibility="{TemplateBinding SecondaryValue, Converter={StaticResource HideWhenEmptyText}}"/>
                            </StackPanel>

                            <Grid Margin="0,12,0,0"
                                  Visibility="{TemplateBinding ShowProgress, Converter={StaticResource HideWhenFalse}}">
                                <ProgressBar Value="{TemplateBinding Progress}" Maximum="100" Height="3"/>
                                <!-- Marker showing where the bar is allowed to stop. -->
                                <controls:BarMarker Position="{TemplateBinding ProgressCap}"
                                                    Height="9"
                                                    VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{TemplateBinding Detail, Converter={StaticResource HideWhenEmptyText}}">
                                <ui:SymbolIcon Symbol="{TemplateBinding DetailIcon}"
                                               FontSize="12"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentPrimary}"
                                               Visibility="{TemplateBinding DetailIcon, Converter={StaticResource HideWhenNoIcon}}"/>
                                <TextBlock Text="{TemplateBinding Detail}" Style="{StaticResource CaptionStyle}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="{TemplateBinding SecondaryDetail, Converter={StaticResource HideWhenEmptyText}}">
                                <ui:SymbolIcon Symbol="{TemplateBinding SecondaryDetailIcon}"
                                               FontSize="12"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentPrimary}"
                                               Visibility="{TemplateBinding SecondaryDetailIcon, Converter={StaticResource HideWhenNoIcon}}"/>
                                <TextBlock Text="{TemplateBinding SecondaryDetail}" Style="{StaticResource CaptionStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         Busy overlay.

         Covers a whole window while something slow and uninterruptible runs -
         a GPU switch takes seconds and restarts driver services, so the controls
         underneath must not be touchable meanwhile.

         Bind Tag to the message and Visibility to the busy flag. Opacity and a
         small scale animate on the way in and out so it does not just appear.
         =================================================================== -->
    <!-- Panel hosted inside the main window: a dimming scrim that closes on click, and
         the content card centred on top of it. -->
    <Style TargetType="{x:Type controls:OverlayHost}">
        <Setter Property="Panel.ZIndex" Value="90"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:OverlayHost}">
                    <Grid x:Name="PART_Root">

                        <!-- The scrim carries its own opacity rather than the whole
                             overlay's, so the dim can lead the card in and follow it
                             out instead of the two arriving as one block.

                             Background is required on the Grid, not decorative: a null
                             brush is not hit-testable and the scrim would never receive
                             the click that closes a light-dismissable panel. -->
                        <Grid x:Name="PART_Scrim" Opacity="0" Background="Transparent">
                            <Border Background="#8A000000"/>

                            <!-- Vignette. A flat dim turns the window into a black slab
                                 and the card into a sticker on it; darkening towards the
                                 edges leaves the card sitting in the one part of the
                                 window that still has light in it. -->
                            <Border>
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.46"
                                                         RadiusX="0.78" RadiusY="0.78">
                                        <GradientStop Offset="0" Color="#00000000"/>
                                        <GradientStop Offset="0.55" Color="#2E000000"/>
                                        <GradientStop Offset="1" Color="#6B000000"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <Grid x:Name="PART_Card" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PART_Scale" ScaleX="0.94" ScaleY="0.94"/>
                                    <!-- The card rises the last few pixels into place.
                                         Scale alone at these sizes is a 6% change nobody
                                         can see; travel is what reads as motion. -->
                                    <TranslateTransform x:Name="PART_Translate" Y="18"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- Shadow plate: an empty rounded rectangle the size of the
                                 card, behind it. The effect rasterises this one shape,
                                 so the panel's own text never goes through the effect
                                 pipeline - which it would if the shadow sat on the
                                 border that holds the content. -->
                            <Border Background="#FF05070A"
                                    CornerRadius="{StaticResource RadiusFlyout}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="24" IsHitTestVisible="False"
                                    Width="{Binding ActualWidth, ElementName=PART_Surface}"
                                    Height="{Binding ActualHeight, ElementName=PART_Surface}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="64" ShadowDepth="18" Direction="270"
                                                      Opacity="0.62" RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>

                            <Border x:Name="PART_Surface"
                                    Background="{DynamicResource SurfaceLayer}"
                                    BorderBrush="{DynamicResource StrokeSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusFlyout}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="{TemplateBinding PanelMaxWidth}"
                                    MaxHeight="{TemplateBinding PanelMaxHeight}"
                                    Margin="24">
                                <Grid>
                                    <ContentPresenter/>

                                    <!-- Rim light along the top edge, over the content
                                         rather than under it: the panels paint their own
                                         backgrounds to the card's edge, so a highlight
                                         behind them would never be seen. -->
                                    <Border CornerRadius="15" BorderThickness="1" IsHitTestVisible="False">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#24FFFFFF"/>
                                                <GradientStop Offset="0.35" Color="#0BFFFFFF"/>
                                                <GradientStop Offset="1" Color="#00FFFFFF"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Progress hairline. The fill is full width and scaled down from the left edge,
         so the control animates without re-measuring anything around it. -->
    <Style TargetType="{x:Type controls:ProgressLine}">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Background" Value="{DynamicResource StrokeDivider}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ProgressLine}">
                    <Grid ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <Border Background="{TemplateBinding Foreground}" CornerRadius="2"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PART_Fill" ScaleX="0" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One panel of a wizard. The transforms are named so the control can drive them
         directly; ClipToBounds keeps the sliding panel inside the card. -->
    <Style TargetType="{x:Type controls:StepPresenter}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StepPresenter}">
                    <Grid ClipToBounds="True">
                        <ContentPresenter x:Name="PART_Host" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PART_Scale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="PART_Translate" X="0"/>
                                </TransformGroup>
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         SpinnerRing - indeterminate ring, one rotating arc.
         The arc is a dashed circle rather than a path so it stays centred at any
         size, and it is cached so a frame is a rotated blit rather than a fresh
         rasterisation of a stroked, dashed, anti-aliased geometry.
         =================================================================== -->
    <Style TargetType="{x:Type controls:SpinnerRing}">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="StrokeThickness" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SpinnerRing}">
                    <Grid Margin="2">
                        <Ellipse Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding StrokeThickness}"
                                 Opacity="0.16"/>
                        <Ellipse Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding StrokeThickness}"
                                 StrokeDashCap="Round"
                                 StrokeDashArray="8 22"
                                 RenderTransformOrigin="0.5,0.5"
                                 CacheMode="BitmapCache">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="PART_Rotation"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:BusyOverlay}">
        <Setter Property="Panel.ZIndex" Value="99"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BusyOverlay}">
                    <Grid x:Name="PART_Root" Opacity="0">
                        <!-- Scrim: dims and blocks everything underneath. Rounded to the
                             card it covers, because nothing above it clips: a parent
                             Border rounds its own paint, never its child. -->
                        <Border Background="{DynamicResource SurfaceBase}" Opacity="0.82"
                                CornerRadius="{TemplateBinding CornerRadius}"/>

                        <!-- The settle scales the message block rather than the whole
                             overlay. Scaling the root meant every frame of it re-rendered
                             a full-surface scrim, which on the software-composed quick
                             panel cost as much as the rest of the panel put together. -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                    RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <ScaleTransform x:Name="PART_Scale" ScaleX="1.02" ScaleY="1.02"/>
                            </StackPanel.RenderTransform>
                            <!-- Bound to IsActive so the ring's clock is released when idle
                                 instead of running forever behind a collapsed overlay. -->
                            <controls:SpinnerRing Width="42" Height="42"
                                                  HorizontalAlignment="Center"
                                                  IsSpinning="{Binding IsActive, RelativeSource={RelativeSource TemplatedParent}}"
                                                  FrameRate="{Binding FrameRate, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Foreground="{DynamicResource AccentPrimary}"/>
                            <TextBlock Text="{TemplateBinding Message}"
                                       Margin="0,18,0,0"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{TemplateBinding Detail}"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The bar tracks the one real logical offset. Nothing here drives a visual-only
        scroll position, so no synthetic spring, overscroll or deferred-scroll path is
        involved and the thumb can never disagree with the content behind it.
    -->
    <Style x:Key="OverlayPageScrollBarStyle" TargetType="ScrollBar"
           BasedOn="{StaticResource {x:Type ScrollBar}}">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Opacity" Value="0.72"/>
        <Setter Property="Margin" Value="0,4,2,4"/>
        <Setter Property="Panel.ZIndex" Value="2"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PageScrollStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="CanContentScroll" Value="False"/>
        <Setter Property="IsDeferredScrollingEnabled" Value="False"/>
        <Setter Property="controls:SmoothScroll.IsEnabled" Value="True"/>
        <!-- The stock template creates a scrollbar column only when overflow appears,
             changing the content viewport width and moving every centred card. Draw the
             narrow Windows-style bar over the already padded right edge instead. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid ClipToBounds="True">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                Margin="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Style="{StaticResource OverlayPageScrollBarStyle}"
                                   Orientation="Vertical"
                                   HorizontalAlignment="Right"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
