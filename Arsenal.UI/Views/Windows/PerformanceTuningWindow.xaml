<ui:FluentWindow x:Class="Arsenal.UI.Views.Windows.PerformanceTuningWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Custom performance modes"
                  Width="940" Height="760" MinWidth="780" MinHeight="600"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="Mica">
    <Grid Background="{DynamicResource AppContentBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource AppSidebarBackground}"
                BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="0,0,0,1"
                Padding="28,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSubtle}"
                                Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="WeatherDuststorm24" FontSize="18" Foreground="{DynamicResource AccentPrimary}"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Custom performance modes" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Adjust power limits, clocks, thermals, and fan curves for the selected plan." FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="48,14,0,0" MaxWidth="470" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                  MinWidth="300" AutomationProperties.Name="Select plan"/>
                        <ui:Button Grid.Column="1" Content="New plan" Command="{Binding OpenCreateProfileCommand}"
                                   Appearance="Secondary" Icon="{ui:SymbolIcon Add24}" Margin="10,0,0,0"/>
                    </Grid>
                </StackPanel>

                <Grid Grid.Column="1">
                    <ui:Button x:Name="CloseButton" Icon="{ui:SymbolIcon Dismiss24}" Click="CloseWindow_Click"
                               Appearance="Secondary" Width="34" Height="34" Padding="0"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               ToolTip="Close"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <ui:Button Content="Reset profile" Command="{Binding ResetSettingsCommand}"
                                   Appearance="Secondary" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,0,8,0"/>
                        <ui:Button Content="Apply changes" Command="{Binding ApplySettingsCommand}"
                                   Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <ContentControl x:Name="EditorHost" Grid.Row="1"/>
    </Grid>
</ui:FluentWindow>
