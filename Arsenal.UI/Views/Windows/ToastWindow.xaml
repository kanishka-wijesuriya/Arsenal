<Window x:Class="Arsenal.UI.Views.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:Arsenal.UI.Markup"
        Width="456" SizeToContent="Height" MaxHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="False" ResizeMode="NoResize">

    <!-- Stack reflow moves the window itself; the content here stays put for the whole
         move, so the layered surface is never re-uploaded mid-reflow and there is no
         second pipeline that can present a frame out of step with the window position.
         The slack around the card carries the entrance and exit motion and the shadow. -->
    <Grid x:Name="ReflowRoot">
        <Grid x:Name="MotionRoot" Margin="48,128" RenderTransformOrigin="0.5,0.5"
              CacheMode="BitmapCache">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MotionScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="MotionTransform"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <Border x:Name="ToastChrome"
                Background="{DynamicResource SurfaceLayer}"
                BorderBrush="{DynamicResource StrokeSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusOverlay}"
                Padding="14"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.38" Color="Black"/>
            </Border.Effect>

            <!-- Auto columns: hiding the accent bar in the compact design removes its
                 track entirely instead of leaving a gap where it used to be. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="AccentBar" Width="3" CornerRadius="2" Margin="0,2,12,2"
                            Background="{DynamicResource AccentPrimary}"/>

                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}"
                            Background="{DynamicResource AccentSubtle}" VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="18" Foreground="{DynamicResource AccentPrimary}"/>
                    </Border>

                    <!-- The value on its own ("Medium") says nothing about what changed, so
                         the quieter line underneath names the control it belongs to. -->
                    <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="MessageText" Text="{Binding Message}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailText" Text="{Binding Detail}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Dismiss20}" Click="Close_Click"
                               Width="28" Height="28" Padding="0" Appearance="Secondary"
                               VerticalAlignment="Top" ToolTip="{loc:Loc ToastDismiss}"/>
                </Grid>

                <Grid x:Name="LiveValuePanel" Grid.Row="1" Margin="49,12,4,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Height="6" CornerRadius="3" Background="{DynamicResource StrokeSubtle}"
                            VerticalAlignment="Center" ClipToBounds="True">
                        <Border Background="{DynamicResource AccentPrimary}" CornerRadius="3"
                                HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="LiveValueScale" ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <TextBlock x:Name="LiveValueText" Grid.Column="1" Width="42" Margin="10,0,0,0"
                               TextAlignment="Right" VerticalAlignment="Center" FontSize="12"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                </Grid>
            </Grid>
            </Border>

            <Border x:Name="ProgressTrack" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Margin="14,0,14,2"
                Background="{DynamicResource StrokeSubtle}">
            <Border x:Name="ProgressBar" Background="{DynamicResource AccentPrimary}" CornerRadius="1"
                    HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ProgressScale" ScaleX="1"/>
                </Border.RenderTransform>
            </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
