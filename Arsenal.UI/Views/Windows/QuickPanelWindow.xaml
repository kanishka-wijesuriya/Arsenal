<Window x:Class="Arsenal.UI.Views.Windows.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Arsenal.UI.Controls"
        Title="Arsenal Quick Panel" Width="452" SizeToContent="Height" MaxHeight="940"
        WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <Style x:Key="PanelSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>
        <Style x:Key="PanelReadoutLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PanelReadoutValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="PanelReadoutDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- A compact mode box: large enough to scan and tap, but visually quieter
             than the user-configurable quick-setting tiles below it. -->
        <Style x:Key="QuickModeChoiceStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Chrome" Background="{DynamicResource SurfaceCard}"
                                    BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusControl}"/>
                            <Border x:Name="SelectedLayer" Opacity="0" Background="{DynamicResource AccentSubtle}"
                                    BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusControl}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="7,5" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceCardHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectedLayer" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickModeActionStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusControl}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="7,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceCardHover}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.72"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact flyout slider geometry. The wider label keeps "OLED dimming"
             complete. There is no current-value readout here and no scale underneath:
             on a panel this small the thumb already says where the value sits, so the
             two ends of the range move up beside the track and everything that saves
             goes back into track length. The low end is held well clear of the header
             so the label and the number never read as one string. Full-window sliders
             keep the roomier readout-and-scale layout from Components.xaml. -->
        <Style x:Key="QuickPanelValueSliderStyle"
               TargetType="{x:Type controls:ValueSlider}"
               BasedOn="{StaticResource {x:Type controls:ValueSlider}}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="HeaderWidth" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:ValueSlider}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{TemplateBinding Header}"
                                       Width="{TemplateBinding HeaderWidth}"
                                       Margin="0,0,16,0"
                                       FontSize="13"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       Visibility="{TemplateBinding Header, Converter={StaticResource HideWhenEmptyText}}"/>

                            <!-- Fixed end columns, so stacked sliders start and finish
                                 their tracks together however wide their numbers are.
                                 Each label is aligned towards its own end of the track. -->
                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding MinimumText}"
                                       Width="30" TextAlignment="Right"
                                       Margin="0,0,6,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center"/>

                            <Slider x:Name="PART_Slider"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Minimum="{TemplateBinding Minimum}"
                                    Maximum="{TemplateBinding Maximum}"
                                    TickFrequency="{TemplateBinding TickFrequency}"
                                    Ticks="{TemplateBinding Ticks}"
                                    IsSnapToTickEnabled="{TemplateBinding IsSnapToTickEnabled}"
                                    IsEnabled="{TemplateBinding IsEnabled}"
                                    Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="3"
                                       Text="{TemplateBinding MaximumText}"
                                       Width="34" TextAlignment="Left"
                                       Margin="6,0,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One row of a detail page: a checkmark gutter, the state, and what it does. -->
        <Style x:Key="DetailOptionStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource RadiusControl}"/>
                            <Border x:Name="HoverLayer" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource SurfaceCardHover}"
                                    CornerRadius="{StaticResource RadiusControl}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard TargetName="HoverLayer">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource StateFadeDuration}">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard TargetName="HoverLayer">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateFadeDuration}">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MotionRoot" Margin="10" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PanelTransform"/>
        </Grid.RenderTransform>

        <!-- The shadow is cast by a shape of its own, sitting behind the card and holding
             nothing. An Effect on the card itself is invalidated whenever anything inside
             it changes, so a page slide or tile drag would re-blur the whole panel. This
             separate surface changes only when the card height does. -->
        <Border x:Name="PanelShadow"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                Background="{DynamicResource SurfaceLayer}"
                CornerRadius="{StaticResource RadiusFlyout}"
                Height="{Binding ActualHeight, ElementName=PanelChrome}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.45" Color="Black"
                                  RenderingBias="Performance"/>
            </Border.Effect>
        </Border>

        <Border x:Name="PanelChrome"
                VerticalAlignment="Bottom"
                Background="{DynamicResource SurfaceLayer}"
                BorderBrush="{DynamicResource StrokeSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusFlyout}"
                Padding="16"
                TextElement.Foreground="{DynamicResource TextPrimary}">

            <!-- The host is clipped to the active view's animated height. The native
                 layered window stays fixed, preventing resize flashes and tray jitter. -->
            <Grid x:Name="TransitionHost" ClipToBounds="True">
                <!-- ================= Main view =================
                     Deliberately uncached because live telemetry changes it. The tile
                     strip inside carries its own retained cache, so paging remains a
                     compositor-only transform without freezing the readouts. -->
                <ScrollViewer x:Name="MainView"
                              VerticalAlignment="Top"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ScrollViewer.RenderTransform>
                        <TranslateTransform x:Name="MainViewShift"/>
                    </ScrollViewer.RenderTransform>
                    <StackPanel x:Name="MainContent">

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- The application's own mark, not a glyph standing in for it:
                             the panel is the first thing most people see of Arsenal. The
                             bare chevrons rather than the app icon tile, so the mark sits
                             on the panel itself with nothing boxed around it. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Cropped to the chevrons' own bounds inside artwork that is
                                 padded on every side; without the crop this height would
                                 be the padding's height and the mark would read smaller
                                 than the words beside it. Assembly-qualified, so it also
                                 resolves when the window is hosted by something other than
                                 Arsenal.exe - which is how the smoke tools render it. -->
                            <Image Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Source>
                                    <CroppedBitmap Source="pack://application:,,,/Arsenal;component/Assets/arsenal-mark.png"
                                                   SourceRect="196,156,632,692"/>
                                </Image.Source>
                            </Image>
                            <TextBlock Text="Your Arsenal" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="Open app" Click="OpenFullApp_Click" Appearance="Secondary"
                                       Padding="12,5" FontSize="12" Margin="0,0,8,0"/>
                            <!-- Square, and the same height as Open app beside it, so the
                                 two read as one row of controls rather than two sizes. -->
                            <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Click="ClosePanel_Click" Appearance="Secondary"
                                       Width="28" Height="28" Padding="0" FontSize="12"
                                       ToolTip="Close"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource SurfaceCard}"
                            BorderBrush="{DynamicResource StrokeSubtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusCard}"
                            Padding="12"
                            Margin="0,0,0,16">
                        <UniformGrid x:Name="TelemetryReadouts" Columns="4">
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource PanelReadoutLabel}"/>
                                <TextBlock Text="{Binding Telemetry.CpuTemp, StringFormat='{}{0:F0}°'}" Style="{StaticResource PanelReadoutValue}"/>
                                <TextBlock Text="{Binding Telemetry.FanCpuRpm, StringFormat='{}{0} rpm'}" Style="{StaticResource PanelReadoutDetail}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="GPU" Style="{StaticResource PanelReadoutLabel}"/>
                                <TextBlock Text="{Binding Telemetry.GpuTemp, StringFormat='{}{0:F0}°'}" Style="{StaticResource PanelReadoutValue}"/>
                                <TextBlock Text="{Binding Telemetry.FanGpuRpm, StringFormat='{}{0} rpm'}" Style="{StaticResource PanelReadoutDetail}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Battery" Style="{StaticResource PanelReadoutLabel}"/>
                                <TextBlock Text="{Binding Telemetry.BatteryPercentage, StringFormat='{}{0}%'}" Style="{StaticResource PanelReadoutValue}"/>
                                <TextBlock Text="{Binding Telemetry.BatteryDischargeRate, StringFormat='{}{0:F1} W'}" Style="{StaticResource PanelReadoutDetail}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Display" Style="{StaticResource PanelReadoutLabel}"/>
                                <TextBlock Text="{Binding RefreshRate, StringFormat='{}{0} Hz'}" Style="{StaticResource PanelReadoutValue}"/>
                                <TextBlock Text="live" Style="{StaticResource PanelReadoutDetail}"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- High-frequency choices live above the customizable tile grid.
                         The first three performance slots are user-selected; the fourth
                         opens the complete tuning surface. -->
                    <StackPanel Margin="0,0,0,13">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Performance modes" Style="{StaticResource PanelSectionLabel}"
                                       Margin="2,0,0,0" VerticalAlignment="Center"/>
                            <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Transparent" Width="28" Height="28" Padding="0"
                                       HorizontalAlignment="Right" Command="{Binding OpenPerformanceShortcutsCommand}"
                                       ToolTip="Choose which three plans appear here"/>
                        </Grid>
                        <UniformGrid x:Name="PerformanceModeRow" Columns="4">
                            <RadioButton Style="{StaticResource QuickModeChoiceStyle}" GroupName="QuickPerformanceModes"
                                         IsChecked="{Binding IsQuickPlan1Selected, Mode=OneWay}"
                                         Command="{Binding SelectQuickPerformancePlanCommand}" CommandParameter="{Binding QuickPlan1}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding QuickPlan1.Icon}" FontSize="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding QuickPlan1.Name}" FontSize="11" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource QuickModeChoiceStyle}" GroupName="QuickPerformanceModes"
                                         IsChecked="{Binding IsQuickPlan2Selected, Mode=OneWay}"
                                         Command="{Binding SelectQuickPerformancePlanCommand}" CommandParameter="{Binding QuickPlan2}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding QuickPlan2.Icon}" FontSize="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding QuickPlan2.Name}" FontSize="11" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource QuickModeChoiceStyle}" GroupName="QuickPerformanceModes"
                                         IsChecked="{Binding IsQuickPlan3Selected, Mode=OneWay}"
                                         Command="{Binding SelectQuickPerformancePlanCommand}" CommandParameter="{Binding QuickPlan3}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding QuickPlan3.Icon}" FontSize="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding QuickPlan3.Name}" FontSize="11" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <Button x:Name="CustomPerformanceButton" Style="{StaticResource QuickModeActionStyle}" Click="OpenPerformanceTuning_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Custom" FontSize="10.5" FontWeight="SemiBold"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <TextBlock Text="GPU modes" Style="{StaticResource PanelSectionLabel}"
                                   Margin="2,10,0,4"/>
                        <UniformGrid x:Name="GpuModeRow" Columns="4">
                            <RadioButton Style="{StaticResource QuickModeChoiceStyle}" GroupName="QuickGpuModes"
                                         IsEnabled="{Binding IsEcoSupported}"
                                         IsChecked="{Binding SelectedGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                         Command="{Binding SelectGpuModeCommand}" CommandParameter="0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="BatterySaver24" FontSize="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Eco" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource QuickModeChoiceStyle}" GroupName="QuickGpuModes"
                                         IsChecked="{Binding SelectedGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                         Command="{Binding SelectGpuModeCommand}" CommandParameter="1">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Glance24" FontSize="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Standard" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource QuickModeChoiceStyle}" GroupName="QuickGpuModes"
                                         IsEnabled="{Binding IsMuxSupported}"
                                         IsChecked="{Binding SelectedGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                                         Command="{Binding SelectGpuModeCommand}" CommandParameter="2">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Flash24" FontSize="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Ultimate" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource QuickModeChoiceStyle}" GroupName="QuickGpuModes"
                                         IsChecked="{Binding SelectedGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"
                                         Command="{Binding SelectGpuModeCommand}" CommandParameter="3">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Optimized" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>

                    <!-- The grid is whatever the user put on it, so the tiles are bound
                         rather than written out here. Options that depend on the model
                         live inside the detail pages; a tile the machine cannot offer is
                         kept out of the picker instead of appearing and doing nothing. -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <!-- Equal outer columns keep the pager on the panel's true
                                 centre line even though the edit controls are wider than
                                 the section label. -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Quick settings" Style="{StaticResource PanelSectionLabel}"
                                   VerticalAlignment="Center" Margin="2,0,0,0"/>

                        <!-- Pages move vertically, while their complete pager stays in
                             one compact, symmetric row directly above the tiles. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,0,0,8"
                                    Visibility="{Binding HasTilePages, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:Button Icon="{ui:SymbolIcon ChevronUp24}" Command="{Binding PreviousTilePageCommand}"
                                       IsEnabled="{Binding CanGoBackTilePage}"
                                       Appearance="Secondary" Width="22" Height="22" Padding="0" FontSize="10"
                                       ToolTip="Scroll to the previous tile page"/>

                            <ItemsControl ItemsSource="{Binding TilePages}" Margin="6,0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource TilePageDotStyle}"
                                                     GroupName="TilePages"
                                                     IsChecked="{Binding IsCurrent, Mode=OneWay}"
                                                     Command="{Binding DataContext.GoToTilePageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="{Binding Index}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ui:Button Icon="{ui:SymbolIcon ChevronDown24}" Command="{Binding NextTilePageCommand}"
                                       IsEnabled="{Binding CanGoForwardTilePage}"
                                       Appearance="Secondary" Width="22" Height="22" Padding="0" FontSize="10"
                                       ToolTip="Scroll to the next tile page"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,0,8">
                            <ui:Button Icon="{ui:SymbolIcon Add24}" Command="{Binding AddTileCommand}"
                                       IsEnabled="{Binding CanAddTile}"
                                       Appearance="Secondary" Width="26" Height="26" Padding="0"
                                       FontSize="11" Margin="0,0,6,0" ToolTip="Add a tile"/>
                            <ui:Button Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetTilesCommand}"
                                       Appearance="Secondary" Width="26" Height="26" Padding="0"
                                       FontSize="11" Margin="0,0,6,0" ToolTip="Restore the default tiles"
                                       Visibility="{Binding IsEditingTiles, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ui:Button Command="{Binding ToggleTileEditingCommand}"
                                       Appearance="Secondary" Height="26" Padding="8,0"
                                       FontSize="11"
                                       Content="{Binding IsEditingTiles, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Done|Edit'}"
                                       ToolTip="Change which tiles the panel shows"/>
                        </StackPanel>
                    </Grid>

                <!-- One flat list of tiles in a viewport clipped to a page's worth of
                      rows; wheel input and the centered pager move the strip vertically
                      rather than rebuilding it. That is what lets a tile be dragged from
                      the end of one page onto the next. -->
                <!-- Keep the tile margins inside the panel. Pulling this viewport three
                     pixels past each edge made the left tile outline and edit affordance
                     look cut off, especially at fractional display scaling. -->
                <Grid Margin="0,0,0,13">
                    <!-- The list sits on a Canvas rather than directly in the Border. A
                         Border passes its own height down as the measure constraint, and
                         WPF then layout-clips a child that measures taller than what it
                         was offered - so the rows past the first page were not merely
                         hidden, they were never rendered. A Canvas measures its children
                         unconstrained, leaving the Border to do the clipping it is here
                         for and nothing else. -->
                    <!-- A transparent background is intentional: WPF does not hit-test
                         a Border's unpainted area. Without it, touchpad/mouse wheel
                         paging only works over an actual tile and not over the empty
                         cells on a partially filled final page. -->
                    <Border x:Name="TilePageViewport"
                            Background="Transparent"
                            ClipToBounds="True"
                            PreviewMouseWheel="TilePageViewport_PreviewMouseWheel">
                        <Canvas>
                        <ItemsControl x:Name="QuickTilesGrid" ItemsSource="{Binding Tiles}"
                                      Width="{Binding ActualWidth, ElementName=TilePageViewport}">
                            <ItemsControl.RenderTransform>
                                <TranslateTransform x:Name="TilePageShift"/>
                            </ItemsControl.RenderTransform>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:AnimatedTileGrid x:Name="TileGridPanel" Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:QuickTile Icon="{Binding Icon}"
                                                    Label="{Binding Label}"
                                                    State="{Binding State}"
                                                    IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                    Command="{Binding DataContext.ActivateTileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ExpandCommand="{Binding ExpandCommand}"
                                                    ExpandCommandParameter="{Binding}"
                                                    IsEditing="{Binding DataContext.IsEditingTiles, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    RemoveCommand="{Binding DataContext.RemoveTileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    RemoveCommandParameter="{Binding}">
                                    <!-- A tile whose hardware is unavailable is dimmed and
                                         inert, but it must still take clicks while the grid
                                         is being rearranged or it could not be removed. -->
                                    <controls:QuickTile.IsEnabled>
                                        <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                                            <Binding Path="IsActionable"/>
                                            <Binding Path="DataContext.IsEditingTiles" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </controls:QuickTile.IsEnabled>
                                </controls:QuickTile>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Canvas>
                    </Border>

                </Grid>

                    <Border Background="{DynamicResource SurfaceCard}"
                            BorderBrush="{DynamicResource StrokeSubtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusCard}"
                            Padding="12,10">
                        <StackPanel>
                            <controls:ValueSlider Style="{StaticResource QuickPanelValueSliderStyle}"
                                                  Header="Brightness" Margin="0,0,0,10"
                                                  Minimum="0" Maximum="100" TickFrequency="5"
                                                  Value="{Binding PanelBrightness}" Format="{}{0}%"/>
                            <controls:ValueSlider Style="{StaticResource QuickPanelValueSliderStyle}"
                                                  Header="OLED dimming" Margin="0,0,0,10"
                                                  Minimum="0" Maximum="100" TickFrequency="5"
                                                  IsEnabled="{Binding IsOledDimmingAvailable}"
                                                  Visibility="{Binding IsOledPanel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Value="{Binding OledDimming}" Format="{}{0}%"/>
                            <controls:ValueSlider Style="{StaticResource QuickPanelValueSliderStyle}"
                                                  Header="Charge limit" Margin="0,0,0,10"
                                                  Minimum="{Binding ChargeLimitMinimum}" Maximum="100" TickFrequency="5"
                                                  Ticks="{Binding ChargeLimitTicks}"
                                                  IsSnapToTickEnabled="{Binding HasSteppedChargeLimit}"
                                                  Value="{Binding ChargeLimit}" Format="{}{0}%"
                                                  PreviewMouseLeftButtonUp="ChargeLimitSlider_Commit"
                                                  KeyUp="ChargeLimitSlider_KeyUp"/>
                            <controls:ValueSlider Style="{StaticResource QuickPanelValueSliderStyle}"
                                                  Header="Keyboard"
                                                  Minimum="0" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                                  Value="{Binding KeyboardBrightness}" Format="{}{0}"
                                                  PreviewMouseLeftButtonUp="KeyboardBrightnessSlider_Commit"
                                                  KeyUp="KeyboardBrightnessSlider_KeyUp"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= Detail view ================= -->
                <!-- No BitmapCache here, unlike the tile page. The option list scrolls, and
                     a cached subtree has to be re-rasterised for every frame of that -
                     which on a layered window costs more than the transition it would
                     save. The tile page never scrolls, so it keeps its cache. -->
                <StackPanel x:Name="DetailView"
                            VerticalAlignment="Top"
                            Visibility="Collapsed"
                            Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="DetailViewShift"/>
                    </StackPanel.RenderTransform>
                    <Grid x:Name="DetailHeader" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding CloseDetailCommand}"
                                   Appearance="Secondary" Width="34" Height="34" Padding="0"
                                   Margin="0,0,10,0" ToolTip="Back to quick settings"/>
                        <TextBlock Grid.Column="1" Text="{Binding DetailTitle}" VerticalAlignment="Center"
                                   FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    </Grid>

                    <!-- The tile picker lists every tile this machine supports, which is
                         far more than a flyout can show at once. The cap is set from the
                         work area in code-behind: the card is anchored to the bottom of
                         the screen, so an uncapped list grew off the top of it. -->
                    <ScrollViewer x:Name="DetailScroll" Style="{StaticResource PageScrollStyle}">
                    <Grid>
                    <ItemsControl x:Name="DetailOptionsList" ItemsSource="{Binding DetailOptions}"
                                  Visibility="{Binding IsStandardDetailPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DetailOptionStyle}"
                                        Command="{Binding DataContext.SelectDetailOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="15"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentPrimary}"
                                                       Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <!-- Only ever set on the tile picker, whose rows are
                                             tiles rather than states, so it cannot collide
                                             with the tick above. -->
                                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="15"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Visibility="{Binding Icon, Converter={StaticResource HideWhenNoIcon}}"/>
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <Border Grid.Column="1"
                                                        Padding="6,2"
                                                        CornerRadius="5"
                                                        Background="{DynamicResource AccentSubtle}"
                                                        BorderBrush="{DynamicResource AccentPrimary}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding Placement, Converter={StaticResource HideWhenEmptyText}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Checkmark24"
                                                                       FontSize="11"
                                                                       Margin="0,0,4,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource AccentPrimary}"/>
                                                        <TextBlock Text="{Binding Placement}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentPrimary}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Margin="0,1,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Visibility="{Binding Detail, Converter={StaticResource HideWhenEmptyText}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding IsPerformanceShortcutEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Background="{DynamicResource AccentSubtle}" BorderBrush="{DynamicResource AccentPrimary}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="12" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Edit24" FontSize="16" Margin="0,1,9,0" Foreground="{DynamicResource AccentPrimary}"/>
                                <TextBlock Text="Pick three different plans for the quick panel. Custom plans appear here as soon as you create them." TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondary}" MaxWidth="340"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="First shortcut" Style="{StaticResource PanelSectionLabel}" Margin="2,0,0,5"/>
                        <ComboBox x:Name="QuickPlanSelector1" ItemsSource="{Binding PerformancePlans}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding QuickPlan1, Mode=TwoWay}" Margin="0,0,0,12"/>

                        <TextBlock Text="Second shortcut" Style="{StaticResource PanelSectionLabel}" Margin="2,0,0,5"/>
                        <ComboBox x:Name="QuickPlanSelector2" ItemsSource="{Binding PerformancePlans}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding QuickPlan2, Mode=TwoWay}" Margin="0,0,0,12"/>

                        <TextBlock Text="Third shortcut" Style="{StaticResource PanelSectionLabel}" Margin="2,0,0,5"/>
                        <ComboBox x:Name="QuickPlanSelector3" ItemsSource="{Binding PerformancePlans}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding QuickPlan3, Mode=TwoWay}" Margin="0,0,0,16"/>

                        <ui:Button Content="Restore Silent, Balanced, and Turbo"
                                   Command="{Binding ResetPerformanceShortcutsCommand}"
                                   Appearance="Secondary" Icon="{ui:SymbolIcon ArrowReset24}"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>
                    </Grid>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Clipped to the panel's own rounded chrome rather than the window, so the
             scrim does not spill into the shadow margin. -->
        <!-- No Background and no IsHitTestVisible here: the Border is only a clip, and
             hit testing is owned by the overlay, which blocks input while active and
             lets it through once idle. -->
        <Border CornerRadius="{StaticResource RadiusFlyout}" ClipToBounds="True"
                VerticalAlignment="Bottom"
                Height="{Binding ActualHeight, ElementName=PanelChrome}">
            <!-- A lower rate than the main window's on purpose. This panel is
                 per-pixel transparent, so WPF composes it in software and cannot hold
                 the display rate while something spins in front of it; a rate it can
                 actually meet looks steadier than a higher one it keeps missing. -->
            <Grid>
                <controls:BusyOverlay IsActive="{Binding IsGpuSwitching}"
                                      Message="{Binding GpuSwitchingMessage}"
                                      FrameRate="45"/>
                <controls:BusyOverlay IsActive="{Binding IsAsusServicesChanging}"
                                      Message="{Binding AsusServicesMessage}"
                                      Detail="{Binding AsusServicesDetail}"
                                      FrameRate="45"/>
            </Grid>
        </Border>

    </Grid>
</Window>
