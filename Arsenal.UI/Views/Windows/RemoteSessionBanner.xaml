<Window x:Class="Arsenal.UI.Views.Windows.RemoteSessionBanner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        Focusable="False" IsTabStop="False"
        Title="Remote session">

    <!-- Stays for the whole session rather than fading like a notification. Somebody
         walking up to this laptop needs to be able to see that it is being driven from
         somewhere else, at the moment they look at it, not three seconds after it
         started. Bottom centre keeps it clear of the tray, where the notifications and
         most windows' own controls are. -->
    <Border x:Name="Chrome" Margin="16"
            Background="{DynamicResource SurfaceLayer}"
            BorderBrush="{DynamicResource StrokeSubtle}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusOverlay}"
            Padding="14,9"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="7" Opacity="0.36" Color="Black"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- A slow pulse rather than a blink. It has to read as live from across a
                 room without becoming the thing you look at while trying to work. -->
            <Ellipse x:Name="LiveDot" Width="9" Height="9" Margin="0,0,11,0"
                     Fill="{DynamicResource AccentPrimary}" VerticalAlignment="Center"/>

            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="HeadlineText" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="DetailText" FontSize="11.5" Margin="0,1,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>

            <ui:Button x:Name="EndButton" Content="End session" Appearance="Secondary"
                       Icon="{ui:SymbolIcon PlugDisconnected24}"
                       Padding="10,4" FontSize="12"
                       Click="End_Click" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
