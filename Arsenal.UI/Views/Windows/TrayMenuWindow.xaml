<Window x:Class="Arsenal.UI.Views.Windows.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:Arsenal.UI.Markup"
        Title="{loc:Loc TrayMenuArsenalMenu}" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual">
    <Window.Resources>

        <!-- A plain command row: glyph, label, optional trailing state. -->
        <Style x:Key="ContextActionStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceCardHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A checked row. The checkmark occupies the same 24px gutter as the glyphs
             above it, so labels line up down the whole menu. -->
        <Style x:Key="ContextRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="Check" Symbol="Checkmark20" FontSize="15"
                                               Foreground="{DynamicResource AccentPrimary}" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceCardHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuGroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10,6,0,4"/>
        </Style>

        <Style x:Key="MenuSeparator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource StrokeDivider}"/>
            <Setter Property="Margin" Value="8,6,8,6"/>
        </Style>

        <Style x:Key="MenuGlyph" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

    </Window.Resources>

    <Grid x:Name="MotionRoot" Margin="8">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="MenuTransform"/>
        </Grid.RenderTransform>

        <Border Background="{DynamicResource SurfaceLayer}"
                BorderBrush="{DynamicResource StrokeSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusOverlay}"
                Padding="6"
                TextElement.Foreground="{DynamicResource TextPrimary}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.42" Color="Black"/>
            </Border.Effect>

            <StackPanel>
                <Button Style="{StaticResource ContextActionStyle}" Click="OpenApp_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Open24" Style="{StaticResource MenuGlyph}"/>
                        <TextBlock Text="{loc:Loc TrayMenuOpenArsenal}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ContextActionStyle}" Click="QuickPanel_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PanelRight24" Style="{StaticResource MenuGlyph}"/>
                        <TextBlock Text="{loc:Loc TrayMenuQuickPanel}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource MenuSeparator}"/>
                <TextBlock Text="{loc:Loc TrayMenuPERFORMANCEMODE}" Style="{StaticResource MenuGroupLabel}"/>
                <RadioButton Style="{StaticResource ContextRadioStyle}" GroupName="TrayPerformance" Content="{loc:Loc Silent}"
                             IsChecked="{Binding SelectedPerformanceMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                             Command="{Binding SelectPerformanceModeCommand}" CommandParameter="2" Click="MenuSelection_Click"/>
                <RadioButton Style="{StaticResource ContextRadioStyle}" GroupName="TrayPerformance" Content="{loc:Loc Balanced}"
                             IsChecked="{Binding SelectedPerformanceMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                             Command="{Binding SelectPerformanceModeCommand}" CommandParameter="0" Click="MenuSelection_Click"/>
                <RadioButton Style="{StaticResource ContextRadioStyle}" GroupName="TrayPerformance" Content="{loc:Loc Turbo}"
                             IsChecked="{Binding SelectedPerformanceMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                             Command="{Binding SelectPerformanceModeCommand}" CommandParameter="1" Click="MenuSelection_Click"/>

                <Border Style="{StaticResource MenuSeparator}"/>
                <TextBlock Text="{loc:Loc TrayMenuGPUMODE}" Style="{StaticResource MenuGroupLabel}"/>
                <RadioButton Style="{StaticResource ContextRadioStyle}" GroupName="TrayGpu" Content="{loc:Loc DisplayEcoIGPUOnly}"
                             Visibility="{Binding IsEcoSupported, Converter={StaticResource BooleanToVisibilityConverter}}"
                             IsChecked="{Binding SelectedGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                             Command="{Binding SelectGpuModeCommand}" CommandParameter="0" Click="MenuSelection_Click"/>
                <RadioButton Style="{StaticResource ContextRadioStyle}" GroupName="TrayGpu" Content="{loc:Loc DisplayStandardHybrid}"
                             IsChecked="{Binding SelectedGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                             Command="{Binding SelectGpuModeCommand}" CommandParameter="1" Click="MenuSelection_Click"/>
                <RadioButton Style="{StaticResource ContextRadioStyle}" GroupName="TrayGpu" Content="{loc:Loc DisplayUltimateMUX}"
                             Visibility="{Binding IsMuxSupported, Converter={StaticResource BooleanToVisibilityConverter}}"
                             IsChecked="{Binding SelectedGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                             Command="{Binding SelectGpuModeCommand}" CommandParameter="2" Click="MenuSelection_Click"/>
                <RadioButton Style="{StaticResource ContextRadioStyle}" GroupName="TrayGpu" Content="{loc:Loc DisplayOptimizedAutomatic}"
                             IsChecked="{Binding SelectedGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"
                             Command="{Binding SelectGpuModeCommand}" CommandParameter="3" Click="MenuSelection_Click"/>

                <Border Style="{StaticResource MenuSeparator}"/>
                <Button Style="{StaticResource ContextActionStyle}" Click="Overlay_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="DataUsage24" Style="{StaticResource MenuGlyph}"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc AdvancedHardwareOverlay}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding IsHardwareOverlay, Converter={StaticResource BoolToTextConverter}}"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource ContextActionStyle}" Click="Settings_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource MenuGlyph}"/>
                        <TextBlock Text="{loc:Loc SettingsSettings}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource MenuSeparator}"/>
                <Button Style="{StaticResource ContextActionStyle}" Click="Quit_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Power24" Style="{StaticResource MenuGlyph}"/>
                        <TextBlock Text="{loc:Loc Quit}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
