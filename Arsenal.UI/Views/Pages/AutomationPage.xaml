<UserControl x:Class="Arsenal.UI.Views.Pages.AutomationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Arsenal.UI.Controls"
             xmlns:vm="clr-namespace:Arsenal.UI.ViewModels"
>
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel Style="{StaticResource PageBodyStyle}">

            <Grid Style="{StaticResource PageHeaderStyle}">
                <StackPanel>
                    <TextBlock Text="Automation" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="What should happen on its own when the power source or the lid changes" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
            </Grid>

            <controls:SettingsGroup Header="Power source" Icon="Flash24"
                                    Description="Apply a performance profile automatically when the charger is plugged in or pulled out.">
                <controls:SettingsRow Header="Switch profile with the power source">
                    <ui:ToggleSwitch IsChecked="{Binding IsAutoSwitchEnabled, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="On AC power" IsEnabled="{Binding IsAutoSwitchEnabled}">
                    <WrapPanel Style="{StaticResource RowChoiceGroupStyle}">
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="AcMode" Content="Silent"
                                     IsChecked="{Binding AcMode, Mode=TwoWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"/>
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="AcMode" Content="Balanced"
                                     IsChecked="{Binding AcMode, Mode=TwoWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"/>
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="AcMode" Content="Turbo"
                                     IsChecked="{Binding AcMode, Mode=TwoWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"/>
                    </WrapPanel>
                </controls:SettingsRow>

                <controls:SettingsRow Header="On battery" IsEnabled="{Binding IsAutoSwitchEnabled}">
                    <WrapPanel Style="{StaticResource RowChoiceGroupStyle}">
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="BatteryMode" Content="Silent"
                                     IsChecked="{Binding BatteryMode, Mode=TwoWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"/>
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="BatteryMode" Content="Balanced"
                                     IsChecked="{Binding BatteryMode, Mode=TwoWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"/>
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="BatteryMode" Content="Turbo"
                                     IsChecked="{Binding BatteryMode, Mode=TwoWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"/>
                    </WrapPanel>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="Graphics and lid" Icon="Laptop24"
                                    Description="Rules that change GPU mode on battery and react to the lid without being asked.">
                <controls:SettingsRow Header="Eco GPU mode on battery"
                                      Description="Switch the dedicated GPU off entirely once the charger is unplugged.">
                    <ui:ToggleSwitch IsChecked="{Binding IsAutoEcoOnBattery, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Clamshell mode"
                                      Description="Stay awake with the lid closed while an external monitor is connected.">
                    <ui:ToggleSwitch IsChecked="{Binding IsClamshellMode, Mode=TwoWay}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

        </StackPanel>
    </ScrollViewer>
</UserControl>
