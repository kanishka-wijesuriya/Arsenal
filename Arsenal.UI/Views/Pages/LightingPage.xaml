<UserControl x:Class="Arsenal.UI.Views.Pages.LightingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Arsenal.UI.Controls"
             xmlns:vm="clr-namespace:Arsenal.UI.ViewModels"
>
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel Style="{StaticResource PageBodyStyle}">

            <Grid Style="{StaticResource PageHeaderStyle}">
                <StackPanel>
                    <TextBlock Text="Lighting" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Keyboard Aura, lightbar, Anime Matrix and Slash controls" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
            </Grid>

            <controls:SettingsGroup Header="Keyboard backlight" Icon="Lightbulb24"
                                    Description="Brightness, Aura effect, colour and speed for the keyboard and the lightbar.">
                <controls:SettingsRow Header="Brightness" Description="Keyboard and lightbar illumination level.">
                    <WrapPanel Style="{StaticResource RowChoiceGroupStyle}">
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="KeyboardBrightness" Content="Off"
                                     IsChecked="{Binding Brightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                     Command="{Binding SetBrightnessLevelCommand}" CommandParameter="0"/>
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="KeyboardBrightness" Content="Low"
                                     IsChecked="{Binding Brightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                     Command="{Binding SetBrightnessLevelCommand}" CommandParameter="1"/>
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="KeyboardBrightness" Content="Medium"
                                     IsChecked="{Binding Brightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                                     Command="{Binding SetBrightnessLevelCommand}" CommandParameter="2"/>
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="KeyboardBrightness" Content="Max"
                                     IsChecked="{Binding Brightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"
                                     Command="{Binding SetBrightnessLevelCommand}" CommandParameter="3"/>
                    </WrapPanel>
                </controls:SettingsRow>

                <!--
                     The keyboard itself, drawn to scale and lit by whichever effect is
                     selected. Placed above the effect list rather than below it, so
                     picking an effect and seeing the result do not need a scroll
                     between them.
                -->
                <controls:SettingsRow Header="Preview"
                                      Description="{Binding PreviewCaption}"
                                      Visibility="{Binding HasKeyboardPreviewOrColor, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SettingsRow.ContentBelow>
                        <!-- The colour and the keyboard it lands on, side by side. The
                             picker used to be a row of its own further down, so choosing
                             a colour and seeing it took a scroll between them and the
                             preview spent that scroll showing the colour you had left
                             behind. Same reason the preview sits above the effect list.

                             The keyboard takes what is left after the picker rather than
                             the picker taking what is left after the keyboard: the
                             picker stops being usable below about 240px, while the
                             keyboard only gets smaller. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Visibility="{Binding HasAuraEffects, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border CornerRadius="{DynamicResource RadiusCard}"
                                        Background="{DynamicResource SurfaceSunken}"
                                        BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"
                                        Padding="14" HorizontalAlignment="Left" MaxWidth="880">
                                    <controls:KeyboardPreview x:Name="BacklightPreview"
                                                              Mode="{Binding SelectedMode}"
                                                              Speed="{Binding Speed}"
                                                              PrimaryColor="{Binding SelectedColor}"
                                                              SecondaryColor="{Binding SecondaryColor}"
                                                              Brightness="{Binding Brightness}"
                                                              BacklightType="{Binding BacklightZoneType}"
                                                              ShowKeyEdgeLighting="{Binding PreviewKeyEdgeLighting}"
                                                              Layout="{Binding PreviewLayout}"/>
                                </Border>

                                <WrapPanel Margin="0,12,0,0">
                                    <TextBlock Text="Keyboard shape" Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <ui:ToggleSwitch Content="Number pad" Margin="0,0,20,0"
                                                     IsChecked="{Binding PreviewNumpad, Mode=TwoWay}"/>
                                    <ui:ToggleSwitch Content="Tall Enter key (ISO)" Margin="0,0,20,0"
                                                     IsChecked="{Binding PreviewIso, Mode=TwoWay}"/>
                                    <ui:ToggleSwitch Content="Light around keycaps"
                                                     ToolTip="Preview coloured light around each keycap. Turn this off when only the printed legends are backlit."
                                                     IsChecked="{Binding PreviewKeyEdgeLighting, Mode=TwoWay}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding PreviewShapeSource}" Style="{StaticResource CaptionStyle}"
                                           TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Only a gutter, and only when there is something on both
                                 sides of it. A fixed column would leave 24px of nothing
                                 down the side of a white-only keyboard. -->
                            <Border Grid.Column="1" Width="24"
                                    Visibility="{Binding HasKeyboardColor, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <StackPanel Grid.Column="2" Width="248" VerticalAlignment="Top"
                                        Visibility="{Binding HasKeyboardColor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- No heading over it. A square of colour beside a
                                     keyboard that changes as you drag on it does not
                                     need to be told it is the colour picker, and the
                                     tooltip carries the one thing the shape does not
                                     say - which axis is which. -->
                                <controls:ColorSpectrumPicker SelectedColor="{Binding SelectedColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Height="196"
                                                              ToolTip="Choose saturation and brightness, then use the hue strip below"/>

                                <!-- The swatch beside the values rather than over them:
                                     stacked, this column ran taller than the keyboard it
                                     stands next to. -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0"
                                            CornerRadius="{DynamicResource RadiusCard}"
                                            Background="{Binding ColorPreviewBrush}"
                                            BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HexColor}" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding RgbColor}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Presets" Style="{StaticResource CaptionStyle}" Margin="0,14,0,0"/>
                                <WrapPanel Margin="0,8,-6,-6">
                                    <ui:Button Command="{Binding SetPresetColorCommand}" CommandParameter="#FF3B30" ToolTip="Red" Width="32" Height="32" Padding="0" Margin="0,0,6,6"><Border Width="16" Height="16" CornerRadius="8" Background="#FF3B30"/></ui:Button>
                                    <ui:Button Command="{Binding SetPresetColorCommand}" CommandParameter="#FF9F0A" ToolTip="Orange" Width="32" Height="32" Padding="0" Margin="0,0,6,6"><Border Width="16" Height="16" CornerRadius="8" Background="#FF9F0A"/></ui:Button>
                                    <ui:Button Command="{Binding SetPresetColorCommand}" CommandParameter="#32D74B" ToolTip="Green" Width="32" Height="32" Padding="0" Margin="0,0,6,6"><Border Width="16" Height="16" CornerRadius="8" Background="#32D74B"/></ui:Button>
                                    <ui:Button Command="{Binding SetPresetColorCommand}" CommandParameter="#0A84FF" ToolTip="Blue" Width="32" Height="32" Padding="0" Margin="0,0,6,6"><Border Width="16" Height="16" CornerRadius="8" Background="#0A84FF"/></ui:Button>
                                    <ui:Button Command="{Binding SetPresetColorCommand}" CommandParameter="#BF5AF2" ToolTip="Purple" Width="32" Height="32" Padding="0" Margin="0,0,6,6"><Border Width="16" Height="16" CornerRadius="8" Background="#BF5AF2"/></ui:Button>
                                    <ui:Button Command="{Binding SetPresetColorCommand}" CommandParameter="#FFFFFF" ToolTip="White" Width="32" Height="32" Padding="0" Margin="0,0,6,6"><Border Width="16" Height="16" CornerRadius="8" Background="#FFFFFF"/></ui:Button>
                                </WrapPanel>

                                <!-- Under the picker, not in the group's footer. The
                                     picker used to be the last row before that footer,
                                     so the button sat directly beneath it; from up here
                                     the same button is below the effect list and the
                                     speed, and choosing a colour would mean scrolling
                                     past two unrelated rows to commit it. -->
                                <ui:Button Content="Apply colour" Icon="{ui:SymbolIcon Checkmark24}"
                                           Command="{Binding ApplyColorCommand}"
                                           Appearance="Primary"
                                           HorizontalAlignment="Stretch"
                                           Margin="0,18,0,0"/>
                            </StackPanel>
                        </Grid>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Aura effect"
                                      Visibility="{Binding HasAuraEffects, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SettingsRow.ContentBelow>
                        <ItemsControl ItemsSource="{Binding AuraModes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Style="{StaticResource ChoiceGroupStyle}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="AuraMode"
                                                 Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SetAuraModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding Value}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Animation speed" Description="Used by the animated Aura effects.">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Margin="0,0,8,0" MinWidth="84" GroupName="AuraSpeed" Content="Slow"
                                     IsChecked="{Binding Speed, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                     Command="{Binding SetSpeedCommand}" CommandParameter="0"/>
                        <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Margin="0,0,8,0" MinWidth="84" GroupName="AuraSpeed" Content="Normal"
                                     IsChecked="{Binding Speed, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                     Command="{Binding SetSpeedCommand}" CommandParameter="1"/>
                        <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Margin="0" MinWidth="84" GroupName="AuraSpeed" Content="Fast"
                                     IsChecked="{Binding Speed, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                                     Command="{Binding SetSpeedCommand}" CommandParameter="2"/>
                    </StackPanel>
                </controls:SettingsRow>

            </controls:SettingsGroup>

            <controls:SettingsGroup Header="Lighting power states" Icon="Power24"
                                    Description="When the keyboard backlight and RGB lightbar are allowed to be on.">
                <controls:SettingsRow Header="Stay lit during">
                    <controls:SettingsRow.ContentBelow>
                        <UniformGrid Columns="2">
                            <CheckBox Style="{StaticResource ListCheckBoxStyle}" Content="Awake: laptop in use" IsChecked="{Binding Awake, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource ListCheckBoxStyle}" Content="Boot: startup sequence" IsChecked="{Binding Boot, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource ListCheckBoxStyle}" Content="Sleep: standby" IsChecked="{Binding Sleep, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource ListCheckBoxStyle}" Content="Shutdown: powered off on AC" IsChecked="{Binding Shutdown, Mode=TwoWay}"/>
                        </UniformGrid>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{Binding LightingDeviceTitle}" Icon="Diversity24"
                                    Description="Choose the running visual, when the display is allowed to run, and how it behaves."
                                    Visibility="{Binding HasMatrixOrSlash, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsRow Header="Visual">
                    <controls:SettingsRow.ContentBelow>
                        <ItemsControl ItemsSource="{Binding MatrixModes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Style="{StaticResource ChoiceGroupStyle}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="MatrixMode"
                                                 Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SetMatrixRunningModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding Value}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Brightness">
                    <controls:SettingsRow.ContentBelow>
                        <WrapPanel Style="{StaticResource ChoiceGroupStyle}">
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="MatrixBrightness" Content="Off"
                                         IsChecked="{Binding MatrixBrightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                         Command="{Binding SetMatrixBrightnessLevelCommand}" CommandParameter="0"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="MatrixBrightness" Content="Low"
                                         IsChecked="{Binding MatrixBrightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                         Command="{Binding SetMatrixBrightnessLevelCommand}" CommandParameter="1"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="MatrixBrightness" Content="Medium"
                                         IsChecked="{Binding MatrixBrightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                                         Command="{Binding SetMatrixBrightnessLevelCommand}" CommandParameter="2"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="MatrixBrightness" Content="High"
                                         IsChecked="{Binding MatrixBrightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"
                                         Command="{Binding SetMatrixBrightnessLevelCommand}" CommandParameter="3"/>
                        </WrapPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Turn off on battery">
                    <ui:ToggleSwitch IsChecked="{Binding MatrixDisableOnBattery, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Turn off when the lid is closed">
                    <ui:ToggleSwitch IsChecked="{Binding MatrixDisableWithLid, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Rotate 180°"
                                      Visibility="{Binding HasAnimeMatrix, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding MatrixFlip, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <!-- Slash only. This group is shared with AniMe Matrix machines, which
                     have none of the rows below, so each is gated the same way the
                     rotation above is rather than the group being split in two. -->
                <controls:SettingsRow Header="Animation interval"
                                      Visibility="{Binding HasSlash, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:ValueSlider Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                          Value="{Binding SlashInterval, Mode=TwoWay}" Format="{}{0} s"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Boot animation"
                                      Visibility="{Binding HasSlash, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding SlashBootAnimation, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Sleep animation"
                                      Visibility="{Binding HasSlash, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding SlashSleepAnimation, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Sleep pattern"
                                      Visibility="{Binding HasSlash, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ComboBox SelectedIndex="{Binding SlashSleepPattern, Mode=TwoWay}" MinWidth="240">
                        <ComboBoxItem Content="System default"/>
                        <ComboBoxItem Content="Selected animation"/>
                    </ComboBox>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Low-battery alert"
                                      Visibility="{Binding HasSlash, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding SlashLowBatteryAlert, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Battery-level indicator"
                                      Visibility="{Binding HasSlash, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding SlashBatteryIndicator, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Dim at low battery"
                                      Visibility="{Binding HasSlash, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding SlashPowerSaving, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Low-battery dim level"
                                      Visibility="{Binding HasSlash, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ComboBox ItemsSource="{Binding SlashDimLevels}" SelectedItem="{Binding SlashDimLevel, Mode=TwoWay}" MinWidth="240"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="AniMe Matrix content" Icon="Image24"
                                    Description="Choose a picture, create text, configure the clock, or react to audio."
                                    Visibility="{Binding HasAnimeMatrix, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsRow Header="Picture">
                    <ui:Button Content="Picture / Gif" Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding ChooseMatrixPictureCommand}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Text">
                    <controls:SettingsRow.ContentBelow>
                        <StackPanel Margin="0,8,0,0">
                            <TextBox Text="{Binding MatrixText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                     ToolTip="First line"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding MatrixFonts}" SelectedIndex="{Binding MatrixTextFont}"/>
                                <controls:ValueSlider Grid.Column="2" Minimum="8" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"
                                                      Header="Size" Value="{Binding MatrixTextSize}"/>
                            </Grid>
                            <TextBox Text="{Binding MatrixText2, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                     ToolTip="Second line"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding MatrixFonts}" SelectedIndex="{Binding MatrixTextFont2}"/>
                                <controls:ValueSlider Grid.Column="2" Minimum="8" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"
                                                      Header="Size" Value="{Binding MatrixTextSize2}"/>
                            </Grid>
                            <DockPanel>
                                <ui:ToggleSwitch Content="Running Text" IsChecked="{Binding MatrixTextRunning}"/>
                                <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Apply"
                                           Appearance="Primary" Command="{Binding ApplyMatrixTextCommand}"/>
                            </DockPanel>
                        </StackPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Clock">
                    <controls:SettingsRow.ContentBelow>
                        <StackPanel Margin="0,8,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MatrixTimeFormat, UpdateSourceTrigger=PropertyChanged}" ToolTip="Time Format"/>
                                <TextBox Grid.Column="2" Text="{Binding MatrixDateFormat, UpdateSourceTrigger=PropertyChanged}" ToolTip="Date Format"/>
                            </Grid>
                            <DockPanel>
                                <ui:ToggleSwitch Content="Show battery instead of date" IsChecked="{Binding MatrixClockBattery}"/>
                                <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Apply"
                                           Appearance="Primary" Command="{Binding ApplyMatrixClockCommand}"/>
                            </DockPanel>
                        </StackPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Audio">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox SelectedIndex="{Binding MatrixAudioMode}" MinWidth="180" Margin="0,0,8,0">
                            <ComboBoxItem Content="Bars"/>
                            <ComboBoxItem Content="Spectrum"/>
                        </ComboBox>
                        <ui:Button Content="Apply" Command="{Binding ApplyMatrixAudioCommand}"/>
                    </StackPanel>
                </controls:SettingsRow>
            </controls:SettingsGroup>

        </StackPanel>
    </ScrollViewer>
</UserControl>
