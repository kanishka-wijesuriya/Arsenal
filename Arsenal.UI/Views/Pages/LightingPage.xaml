<UserControl x:Class="Arsenal.UI.Views.Pages.LightingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Arsenal.UI.Controls"
             xmlns:vm="clr-namespace:Arsenal.UI.ViewModels"
             xmlns:loc="clr-namespace:Arsenal.UI.Markup">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel Style="{StaticResource PageBodyStyle}">

            <Grid Style="{StaticResource PageHeaderStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Lighting}" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="{loc:Loc LightingKeyboardAuraLightbarAnimeMatrix}" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
            </Grid>

            <controls:SettingsGroup Header="{loc:Loc LightingKeyboardBacklight}" Icon="Lightbulb24">
                <controls:SettingsRow Header="{loc:Loc Brightness}" Description="{loc:Loc LightingKeyboardAndLightbarIllumination}">
                    <controls:SettingsRow.ContentBelow>
                        <WrapPanel Style="{StaticResource ChoiceGroupStyle}">
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="KeyboardBrightness" Content="{loc:Loc BacklightOff}"
                                         IsChecked="{Binding Brightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                         Command="{Binding SetBrightnessLevelCommand}" CommandParameter="0"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="KeyboardBrightness" Content="{loc:Loc BacklightLow}"
                                         IsChecked="{Binding Brightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                         Command="{Binding SetBrightnessLevelCommand}" CommandParameter="1"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="KeyboardBrightness" Content="{loc:Loc MatrixMedium}"
                                         IsChecked="{Binding Brightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                                         Command="{Binding SetBrightnessLevelCommand}" CommandParameter="2"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="KeyboardBrightness" Content="{loc:Loc BacklightMax}"
                                         IsChecked="{Binding Brightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"
                                         Command="{Binding SetBrightnessLevelCommand}" CommandParameter="3"/>
                        </WrapPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <!--
                     The keyboard itself, drawn to scale and lit by whichever effect is
                     selected. Placed above the effect list rather than below it, so
                     picking an effect and seeing the result do not need a scroll
                     between them.
                -->
                <controls:SettingsRow Header="{loc:Loc LightingKeyboardPreview}"
                                      Description="{Binding PreviewCaption}"
                                      Visibility="{Binding HasAuraEffects, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SettingsRow.ContentBelow>
                        <StackPanel>
                            <Border CornerRadius="{StaticResource RadiusCard}"
                                    Background="{DynamicResource SurfaceSunken}"
                                    BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"
                                    Padding="14" HorizontalAlignment="Left" MaxWidth="880">
                                <controls:KeyboardPreview x:Name="BacklightPreview"
                                                          Mode="{Binding SelectedMode}"
                                                          Speed="{Binding Speed}"
                                                          PrimaryColor="{Binding SelectedColor}"
                                                          SecondaryColor="{Binding SecondaryColor}"
                                                          Brightness="{Binding Brightness}"
                                                          BacklightType="{Binding BacklightZoneType}"
                                                          Layout="{Binding PreviewLayout}"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="{loc:Loc LightingPreviewLayout}" Style="{StaticResource CaptionStyle}"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <ui:ToggleSwitch Content="{loc:Loc LightingPreviewNumpad}" Margin="0,0,20,0"
                                                 IsChecked="{Binding PreviewNumpad, Mode=TwoWay}"/>
                                <ui:ToggleSwitch Content="{loc:Loc LightingPreviewIso}"
                                                 IsChecked="{Binding PreviewIso, Mode=TwoWay}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PreviewShapeSource}" Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc LightingAuraEffect}"
                                      Visibility="{Binding HasAuraEffects, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SettingsRow.ContentBelow>
                        <ItemsControl ItemsSource="{Binding AuraModes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Style="{StaticResource ChoiceGroupStyle}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="AuraMode"
                                                 Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SetAuraModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding Value}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc LightingAnimationSpeed}" Description="{loc:Loc LightingUsedByTheAnimatedAura}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Margin="0,0,8,0" MinWidth="84" GroupName="AuraSpeed" Content="{loc:Loc AuraSlow}"
                                     IsChecked="{Binding Speed, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                     Command="{Binding SetSpeedCommand}" CommandParameter="0"/>
                        <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Margin="0,0,8,0" MinWidth="84" GroupName="AuraSpeed" Content="{loc:Loc AuraNormal}"
                                     IsChecked="{Binding Speed, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                     Command="{Binding SetSpeedCommand}" CommandParameter="1"/>
                        <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Margin="0" MinWidth="84" GroupName="AuraSpeed" Content="{loc:Loc AuraFast}"
                                     IsChecked="{Binding Speed, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                                     Command="{Binding SetSpeedCommand}" CommandParameter="2"/>
                    </StackPanel>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc DisplayColour}" Description="{loc:Loc LightingPickSaturationAndBrightnessOn}"
                                      Visibility="{Binding HasKeyboardColor, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SettingsRow.ContentBelow>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="236"/>
                            </Grid.ColumnDefinitions>

                            <controls:ColorSpectrumPicker SelectedColor="{Binding SelectedColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Height="206"
                                                          VerticalAlignment="Top"
                                                          ToolTip="{loc:Loc LightingChooseSaturationAndBrightness}"/>

                            <StackPanel Grid.Column="2">
                                <Border Height="72" CornerRadius="{StaticResource RadiusCard}" Background="{Binding ColorPreviewBrush}"
                                        BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"/>

                                <TextBlock Text="{Binding HexColor}" FontFamily="Cascadia Mono, Consolas" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding RgbColor}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0"/>

                                <TextBlock Text="{loc:Loc BatteryPresets}" Style="{StaticResource CaptionStyle}" Margin="0,16,0,0"/>
                                <WrapPanel Margin="0,8,-6,-6">
                                    <ui:Button Command="{Binding SetPresetColorCommand}" CommandParameter="#FF3B30" ToolTip="{loc:Loc LightingRed}" Width="32" Height="32" Padding="0" Margin="0,0,6,6"><Border Width="16" Height="16" CornerRadius="8" Background="#FF3B30"/></ui:Button>
                                    <ui:Button Command="{Binding SetPresetColorCommand}" CommandParameter="#FF9F0A" ToolTip="{loc:Loc LightingOrange}" Width="32" Height="32" Padding="0" Margin="0,0,6,6"><Border Width="16" Height="16" CornerRadius="8" Background="#FF9F0A"/></ui:Button>
                                    <ui:Button Command="{Binding SetPresetColorCommand}" CommandParameter="#32D74B" ToolTip="{loc:Loc LightingGreen}" Width="32" Height="32" Padding="0" Margin="0,0,6,6"><Border Width="16" Height="16" CornerRadius="8" Background="#32D74B"/></ui:Button>
                                    <ui:Button Command="{Binding SetPresetColorCommand}" CommandParameter="#0A84FF" ToolTip="{loc:Loc LightingBlue}" Width="32" Height="32" Padding="0" Margin="0,0,6,6"><Border Width="16" Height="16" CornerRadius="8" Background="#0A84FF"/></ui:Button>
                                    <ui:Button Command="{Binding SetPresetColorCommand}" CommandParameter="#BF5AF2" ToolTip="{loc:Loc LightingPurple}" Width="32" Height="32" Padding="0" Margin="0,0,6,6"><Border Width="16" Height="16" CornerRadius="8" Background="#BF5AF2"/></ui:Button>
                                    <ui:Button Command="{Binding SetPresetColorCommand}" CommandParameter="#FFFFFF" ToolTip="{loc:Loc LightingWhite}" Width="32" Height="32" Padding="0" Margin="0,0,6,6"><Border Width="16" Height="16" CornerRadius="8" Background="#FFFFFF"/></ui:Button>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsGroup.Footer>
                    <ui:Button Content="{loc:Loc LightingApplyColour}" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApplyColorCommand}"
                               Appearance="Primary" HorizontalAlignment="Right"
                               Visibility="{Binding HasKeyboardColor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </controls:SettingsGroup.Footer>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc LightingLightingPowerStates}" Icon="Power24"
                                    Description="{loc:Loc LightingWhenTheKeyboardBacklightAnd}">
                <controls:SettingsRow Header="{loc:Loc LightingStayLitDuring}">
                    <controls:SettingsRow.ContentBelow>
                        <UniformGrid Columns="2">
                            <CheckBox Style="{StaticResource ListCheckBoxStyle}" Content="{loc:Loc LightingAwakeLaptopInUse}" IsChecked="{Binding Awake, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource ListCheckBoxStyle}" Content="{loc:Loc LightingBootStartupSequence}" IsChecked="{Binding Boot, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource ListCheckBoxStyle}" Content="{loc:Loc LightingSleepStandby}" IsChecked="{Binding Sleep, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource ListCheckBoxStyle}" Content="{loc:Loc LightingShutdownPoweredOffOnAC}" IsChecked="{Binding Shutdown, Mode=TwoWay}"/>
                        </UniformGrid>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{Binding LightingDeviceTitle}" Icon="Diversity24"
                                    Description="{loc:Loc LightingChooseTheRunningVisualAnd}"
                                    Visibility="{Binding HasMatrixOrSlash, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsRow Header="{loc:Loc LightingVisual}">
                    <controls:SettingsRow.ContentBelow>
                        <ItemsControl ItemsSource="{Binding MatrixModes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Style="{StaticResource ChoiceGroupStyle}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="MatrixMode"
                                                 Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SetMatrixRunningModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding Value}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc Brightness}">
                    <controls:SettingsRow.ContentBelow>
                        <WrapPanel Style="{StaticResource ChoiceGroupStyle}">
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="MatrixBrightness" Content="{loc:Loc BacklightOff}"
                                         IsChecked="{Binding MatrixBrightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                         Command="{Binding SetMatrixBrightnessLevelCommand}" CommandParameter="0"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="MatrixBrightness" Content="{loc:Loc BacklightLow}"
                                         IsChecked="{Binding MatrixBrightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                         Command="{Binding SetMatrixBrightnessLevelCommand}" CommandParameter="1"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="MatrixBrightness" Content="{loc:Loc MatrixMedium}"
                                         IsChecked="{Binding MatrixBrightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                                         Command="{Binding SetMatrixBrightnessLevelCommand}" CommandParameter="2"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="MatrixBrightness" Content="{loc:Loc High}"
                                         IsChecked="{Binding MatrixBrightness, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"
                                         Command="{Binding SetMatrixBrightnessLevelCommand}" CommandParameter="3"/>
                        </WrapPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc LightingTurnOffOnBattery}">
                    <ui:ToggleSwitch IsChecked="{Binding MatrixDisableOnBattery, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc LightingTurnOffWhenTheLid}">
                    <ui:ToggleSwitch IsChecked="{Binding MatrixDisableWithLid, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc MatrixFlip}"
                                      Visibility="{Binding HasAnimeMatrix, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding MatrixFlip, Mode=TwoWay}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc MatrixContent}" Icon="Image24"
                                    Description="{loc:Loc MatrixContentDescription}"
                                    Visibility="{Binding HasAnimeMatrix, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsRow Header="{loc:Loc MatrixPicture}">
                    <ui:Button Content="{loc:Loc PictureGif}" Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding ChooseMatrixPictureCommand}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc MatrixText}">
                    <controls:SettingsRow.ContentBelow>
                        <StackPanel Margin="0,8,0,0">
                            <TextBox Text="{Binding MatrixText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                     ToolTip="{loc:Loc MatrixFirstLine}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding MatrixFonts}" SelectedIndex="{Binding MatrixTextFont}"/>
                                <controls:ValueSlider Grid.Column="2" Minimum="8" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"
                                                      Header="{loc:Loc MatrixFontSize}" Value="{Binding MatrixTextSize}"/>
                            </Grid>
                            <TextBox Text="{Binding MatrixText2, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                     ToolTip="{loc:Loc MatrixSecondLine}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding MatrixFonts}" SelectedIndex="{Binding MatrixTextFont2}"/>
                                <controls:ValueSlider Grid.Column="2" Minimum="8" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"
                                                      Header="{loc:Loc MatrixFontSize}" Value="{Binding MatrixTextSize2}"/>
                            </Grid>
                            <DockPanel>
                                <ui:ToggleSwitch Content="{loc:Loc MatrixRunningText}" IsChecked="{Binding MatrixTextRunning}"/>
                                <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="{loc:Loc Apply}"
                                           Appearance="Primary" Command="{Binding ApplyMatrixTextCommand}"/>
                            </DockPanel>
                        </StackPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc MatrixClock}">
                    <controls:SettingsRow.ContentBelow>
                        <StackPanel Margin="0,8,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MatrixTimeFormat, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc MatrixTimeFormat}"/>
                                <TextBox Grid.Column="2" Text="{Binding MatrixDateFormat, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc MatrixDateFormat}"/>
                            </Grid>
                            <DockPanel>
                                <ui:ToggleSwitch Content="{loc:Loc MatrixShowBattery}" IsChecked="{Binding MatrixClockBattery}"/>
                                <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="{loc:Loc Apply}"
                                           Appearance="Primary" Command="{Binding ApplyMatrixClockCommand}"/>
                            </DockPanel>
                        </StackPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc MatrixAudio}">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox SelectedIndex="{Binding MatrixAudioMode}" MinWidth="180" Margin="0,0,8,0">
                            <ComboBoxItem Content="{loc:Loc MatrixAudioBars}"/>
                            <ComboBoxItem Content="{loc:Loc MatrixAudioSpectrum}"/>
                        </ComboBox>
                        <ui:Button Content="{loc:Loc Apply}" Command="{Binding ApplyMatrixAudioCommand}"/>
                    </StackPanel>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc LightingSlashBehaviour}" Icon="Timer24"
                                    Visibility="{Binding HasSlash, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsRow Header="{loc:Loc LightingAnimationInterval}">
                    <controls:ValueSlider Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                          Value="{Binding SlashInterval, Mode=TwoWay}" Format="{}{0} s"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc LightingBootAnimation}">
                    <ui:ToggleSwitch IsChecked="{Binding SlashBootAnimation, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc SlashSleepAnimation}">
                    <ui:ToggleSwitch IsChecked="{Binding SlashSleepAnimation, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc LightingSleepPattern}">
                    <ComboBox SelectedIndex="{Binding SlashSleepPattern, Mode=TwoWay}" MinWidth="240">
                        <ComboBoxItem Content="{loc:Loc LightingSystemDefault}"/>
                        <ComboBoxItem Content="{loc:Loc LightingSelectedAnimation}"/>
                    </ComboBox>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc LightingLowBatteryAlert}">
                    <ui:ToggleSwitch IsChecked="{Binding SlashLowBatteryAlert, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc LightingBatteryLevelIndicator}">
                    <ui:ToggleSwitch IsChecked="{Binding SlashBatteryIndicator, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc LightingDimAtLowBattery}">
                    <ui:ToggleSwitch IsChecked="{Binding SlashPowerSaving, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc LightingLowBatteryDimLevel}">
                    <ComboBox ItemsSource="{Binding SlashDimLevels}" SelectedItem="{Binding SlashDimLevel, Mode=TwoWay}" MinWidth="240"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

        </StackPanel>
    </ScrollViewer>
</UserControl>
