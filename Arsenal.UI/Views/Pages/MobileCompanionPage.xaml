<UserControl x:Class="Arsenal.UI.Views.Pages.MobileCompanionPage"
             x:Name="PageRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Arsenal.UI.Controls"
             xmlns:loc="clr-namespace:Arsenal.UI.Markup">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel Style="{StaticResource PageBodyStyle}">
            <Grid Style="{StaticResource PageHeaderStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc MobileCompanionMobileCompanion}" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="{loc:Loc MobileCompanionSecurelyPairPhonesScanConnection}" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
            </Grid>

            <ui:InfoBar Title="{loc:Loc MobileCompanionPrivateByDesign}"
                        Message="Control stays on your local network. Every phone receives its own encrypted credential and pins this PC's TLS certificate."
                        Severity="Informational" IsOpen="True" IsClosable="False"
                        Margin="{StaticResource SectionGap}"/>

            <ui:InfoBar Title="{loc:Loc MobileCompanionAllowPrivateNetworkAccessTo}"
                        Message="Use the button below and approve the Windows prompt. Arsenal will then listen only on its companion port for devices on your local private network."
                        Severity="Warning" IsOpen="True" IsClosable="False"
                        Margin="0,12,0,0"
                        Visibility="{Binding IsNetworkAccessAllowed, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

            <controls:SettingsGroup Header="{loc:Loc MobileCompanionPairAPhone}" Icon="QrCode24"
                                    Description="{loc:Loc MobileCompanionTheAndroidAppCanDiscover}">
                <controls:SettingsRow Header="{loc:Loc MobileCompanionPrivateNetworkAccess}"
                                      Description="{loc:Loc MobileCompanionAllowInboundCompanionHTTPSAnd}">
                    <ui:Button Content="{Binding NetworkAccessButtonLabel}"
                               Command="{Binding AllowCompanionNetworkCommand}"
                               Icon="{ui:SymbolIcon ShieldTask24}"
                               Appearance="Primary"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc MobileCompanionScanFromTheMobileApp}"
                                      Description="{loc:Loc MobileCompanionTheQRIncludesThisPC}"
                                      Visibility="{Binding IsCompanionRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SettingsRow.ContentBelow>
                        <Grid Margin="0,18,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="White" CornerRadius="22" Padding="14" BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1">
                                <Image Source="{Binding PairingQrCode}" Width="210" Height="210" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="28,4,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc SetupPAIRINGCODE}" Foreground="{DynamicResource AccentPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CompanionPairingCode}" FontFamily="Consolas" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,14"/>
                                <TextBlock Text="{loc:Loc MobileCompanionExpiresAfterFiveMinutesOr}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                <ui:Button Content="{loc:Loc MobileCompanionGenerateANewCode}" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                           Command="{Binding RegenerateCompanionCodeCommand}" Appearance="Secondary"
                                           HorizontalAlignment="Left" Margin="0,18,0,0"/>
                            </StackPanel>
                        </Grid>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>
                <controls:SettingsRow Header="{loc:Loc MobileCompanionManualAddress}" Description="{loc:Loc MobileCompanionUseThisIfThePhone}"
                                      Visibility="{Binding IsCompanionRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBox Text="{Binding CompanionAddress, Mode=OneWay}" IsReadOnly="True" MinWidth="220"
                             FontFamily="Consolas" HorizontalContentAlignment="Center"/>
                </controls:SettingsRow>
                <!-- The full identity, not the short preview. A phone pairing by typed
                     address cannot verify this itself, so it shows what it received and
                     asks the person to compare - which needs the whole thing here to
                     compare against. Grouped exactly as the phone groups it. -->
                <controls:SettingsRow Header="{loc:Loc MobileCompanionTLSIdentity}" Description="{loc:Loc MobileCompanionAShortPreviewOfThe}"
                                      Visibility="{Binding IsCompanionRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding CompanionFingerprintBlock}" FontFamily="Consolas" FontSize="12"
                               LineHeight="18" TextAlignment="Right"
                               Foreground="{DynamicResource TextSecondary}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc MobileCompanionConnectedDevices}" Icon="PhoneLaptop24"
                                    Description="{loc:Loc MobileCompanionAPhoneIsShownAs}"
                                    ItemsSource="{Binding Devices}">
                <controls:SettingsGroup.ItemTemplate>
                    <DataTemplate>
                        <controls:SettingsRow Header="{Binding Name}" Description="{Binding Details}" Icon="Phone24">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#8B95A7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Background" Value="#62E6B5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <ui:Button Content="{loc:Loc MobileCompanionRevoke}" Appearance="Secondary" Icon="{ui:SymbolIcon LinkDismiss24}"
                                           Command="{Binding DataContext.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                           CommandParameter="{Binding Id}"/>
                            </StackPanel>
                        </controls:SettingsRow>
                    </DataTemplate>
                </controls:SettingsGroup.ItemTemplate>
                <controls:SettingsGroup.Footer>
                    <ui:Button Content="{loc:Loc MobileCompanionRevokeAllDevices}" Icon="{ui:SymbolIcon LinkDismiss24}"
                               Command="{Binding RevokeAllDevicesCommand}" Appearance="Secondary"
                               HorizontalAlignment="Left" IsEnabled="{Binding HasPairedDevices}"/>
                </controls:SettingsGroup.Footer>
            </controls:SettingsGroup>

            <ui:InfoBar Title="{loc:Loc MobileCompanionNoPhonesPairedYet}"
                        Message="Scan the code above from the Android app to add your first device."
                        Severity="Informational" IsOpen="True" IsClosable="False"
                        Visibility="{Binding HasPairedDevices, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
