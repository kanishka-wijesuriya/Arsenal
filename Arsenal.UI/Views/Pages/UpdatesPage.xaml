<UserControl x:Class="Arsenal.UI.Views.Pages.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Arsenal.UI.Controls"
             xmlns:models="clr-namespace:Arsenal.Application.Models;assembly=Arsenal.Application"
>
    <UserControl.Resources>
        <Style x:Key="DriverSummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="DriverCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceCardHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtle}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DriverVersionCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- The chip that stands in for the action button while a package is coming down.
             Deliberately the same shape and size as the button it replaces: a rounded
             chrome with the percentage on it and a hairline filling underneath.

             The whole chip is the cancel target. That is what lets the state swap cost
             nothing in layout - a separate Cancel control beside it would have to be
             given room, and this cell is in a shared-size column, so that room would be
             taken from every other row on the page at the same time. The caption turns
             into Cancel under the pointer instead. -->
        <Style x:Key="DriverProgressChipStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="{StaticResource RadiusControl}"
                                Background="{DynamicResource SurfaceCardHover}"
                                BorderBrush="{DynamicResource StrokeSubtle}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Grid Margin="9,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Both captions share the cell, so swapping them moves
                                     nothing; only their opacity changes. -->
                                <TextBlock x:Name="Percent" Grid.Row="0"
                                           Text="{Binding DownloadProgressText}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CancelLabel" Grid.Row="0"
                                           Text="Cancel"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <controls:ProgressLine Grid.Row="1" Value="{Binding DownloadFraction}"
                                                       Margin="0,0,0,6"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSelected}"/>
                                <Setter TargetName="Percent" Property="Opacity" Value="0"/>
                                <Setter TargetName="CancelLabel" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel Style="{StaticResource PageBodyStyle}">

            <Grid Style="{StaticResource PageHeaderStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Drivers" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Official ASUS packages matched against the drivers actually installed on this laptop"
                               Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource ActionBarStyle}">
                    <ui:Button Style="{StaticResource ActionButtonStyle}" Margin="0" Content="Scan again"
                               Command="{Binding CheckUpdatesCommand}" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}"
                               IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>
            </Grid>

            <controls:ResponsiveGrid MinItemWidth="190" MaxColumns="4" Margin="-5,0,-5,15">
                <Border Style="{StaticResource DriverSummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="38" Height="38" Margin="0,0,12,0">
                            <Border Background="{DynamicResource StatusWarning}" Opacity="0.14" CornerRadius="8"/>
                            <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="{DynamicResource StatusWarning}" FontSize="19"/>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding OutdatedDriverCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Updates available" Style="{StaticResource CaptionStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource DriverSummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="38" Height="38" Margin="0,0,12,0">
                            <Border Background="{DynamicResource StatusSuccess}" Opacity="0.14" CornerRadius="8"/>
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{DynamicResource StatusSuccess}" FontSize="19"/>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding CurrentDriverCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Up to date" Style="{StaticResource CaptionStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource DriverSummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="38" Height="38" Margin="0,0,12,0">
                            <Border Background="{DynamicResource AccentPrimary}" Opacity="0.14" CornerRadius="8"/>
                            <ui:SymbolIcon Symbol="Info24" Foreground="{DynamicResource AccentPrimary}" FontSize="19"/>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding OptionalDriverCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Optional" Style="{StaticResource CaptionStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource DriverSummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="38" Height="38" Margin="0,0,12,0">
                            <Border Background="{DynamicResource TextSecondary}" Opacity="0.10" CornerRadius="8"/>
                            <ui:SymbolIcon Symbol="BoxMultiple24" Foreground="{DynamicResource TextSecondary}" FontSize="19"/>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DriverCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="ASUS packages" Style="{StaticResource CaptionStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </controls:ResponsiveGrid>

            <Grid Margin="2,0,2,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Driver library" Style="{StaticResource SectionTitleStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SettingDescriptionStyle}"/>
                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="8,0,0,0"
                                         Visibility="{Binding IsChecking, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ChoiceGroupStyle}">
                    <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="DriverFilter"
                                 Content="{Binding AllDriversFilterText}" IsChecked="{Binding SelectedDriverFilter, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                 Command="{Binding SetDriverFilterCommand}" CommandParameter="0"/>
                    <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="DriverFilter"
                                 Content="{Binding OutdatedDriversFilterText}" IsChecked="{Binding SelectedDriverFilter, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                 Command="{Binding SetDriverFilterCommand}" CommandParameter="1"/>
                    <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="DriverFilter"
                                 Content="{Binding CurrentDriversFilterText}" IsChecked="{Binding SelectedDriverFilter, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                                 Command="{Binding SetDriverFilterCommand}" CommandParameter="2"/>
                    <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="DriverFilter"
                                 Content="{Binding OptionalDriversFilterText}" IsChecked="{Binding SelectedDriverFilter, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"
                                 Command="{Binding SetDriverFilterCommand}" CommandParameter="3"/>
                </WrapPanel>
            </Grid>

            <!-- Shared-size scope so every row's action column takes the width of the widest
                 caption. A fixed width fits "Get update" in English by three pixels and
                 clips it in most other languages. -->
            <ItemsControl ItemsSource="{Binding VisibleDrivers}" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DriverCardStyle}">
                            <Grid ClipToBounds="True">
                                <Border x:Name="StateBar" Width="4" Background="{DynamicResource AccentPrimary}"
                                        HorizontalAlignment="Left" CornerRadius="8,0,0,8"/>

                                <!-- One compact Windows Settings-style row. The icon,
                                     two-line identity, version comparison and action all
                                     share the same vertical centre; no nested box adds a
                                     false third line or doubles the row height. -->
                                <Grid Margin="16,10,14,10" MinHeight="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DriverAction"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="40" Height="40" MinWidth="40" MinHeight="40"
                                          Margin="0,0,13,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border x:Name="IconTint" Width="40" Height="40"
                                                Background="{DynamicResource AccentPrimary}" Opacity="0.13" CornerRadius="8"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <ui:SymbolIcon x:Name="StatusIcon" Width="40" Height="40"
                                                       Symbol="Info24" Foreground="{DynamicResource AccentPrimary}" FontSize="19"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="0,0,18,0" VerticalAlignment="Center">
                                        <WrapPanel VerticalAlignment="Center" Margin="0,0,0,3">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SettingLabelStyle}"
                                                       FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                            <Grid VerticalAlignment="Center">
                                                <Border x:Name="StatusPillTint" Background="{DynamicResource AccentPrimary}" Opacity="0.14"
                                                        CornerRadius="10"/>
                                                <Border x:Name="StatusPillStroke" BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="1"
                                                        CornerRadius="10" Padding="8,1">
                                                    <TextBlock x:Name="StatusText" Text="{Binding StateLabel}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentPrimary}"/>
                                                </Border>
                                            </Grid>
                                        </WrapPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ReleaseNotes}" Style="{StaticResource CaptionStyle}"/>
                                            <TextBlock Text="  ·  Released " Style="{StaticResource CaptionStyle}"/>
                                            <TextBlock Text="{Binding PublishedAt}" Style="{StaticResource CaptionStyle}"/>

                                            <!-- Download size, as ASUS words it. Collapsed
                                                 rather than left blank when a package has
                                                 none, so the separator does not dangle. -->
                                            <TextBlock Text="  ·  " Style="{StaticResource CaptionStyle}"
                                                       Visibility="{Binding HasFileSize, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding FileSize}" Style="{StaticResource CaptionStyle}"
                                                       Visibility="{Binding HasFileSize, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- The two follow-ups that used to sit under
                                                 the action button. Down here they cost the
                                                 action cell nothing, and each appears only
                                                 in the state that has any use for it. -->
                                            <TextBlock Text="  ·  " Style="{StaticResource CaptionStyle}"
                                                       Visibility="{Binding IsDownloaded, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ui:HyperlinkButton Content="Show in folder" Padding="0" FontSize="12"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.ShowDriverInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsDownloaded, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <TextBlock Text="  ·  " Style="{StaticResource CaptionStyle}"
                                                       Visibility="{Binding HasFailed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ui:HyperlinkButton Content="Open in browser" NavigateUri="{Binding DownloadUrl}"
                                                                Padding="0" FontSize="12" VerticalAlignment="Center"
                                                                Visibility="{Binding HasFailed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Grid.Column="2" Width="244" Margin="0,0,18,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="106"/>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="106"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                                            <TextBlock Text="INSTALLED" Style="{StaticResource DriverVersionCaptionStyle}" TextAlignment="Right"/>
                                            <TextBlock Text="{Binding InstalledVersionText}" Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="12" FontWeight="SemiBold" Margin="0,1,0,0"
                                                       TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24" Foreground="{DynamicResource TextTertiary}"
                                                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0">
                                            <TextBlock Text="ASUS" Style="{StaticResource DriverVersionCaptionStyle}"/>
                                            <TextBlock Text="{Binding LatestVersion}" Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="12" FontWeight="SemiBold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- One 112px slot, four states, only ever one of them
                                         visible: fetch, in flight, on disk, or failed.
                                         The package is downloaded by the application into
                                         its own folder rather than handed to the browser,
                                         so running it afterwards is a second, deliberate
                                         click here rather than a file the user has to go
                                         and find. -->
                                    <!-- Four states, one footprint. Every state stays
                                         measured and only the live one is painted
                                         (Hidden, not Collapsed), so the cell is always the
                                         size of the largest of them - which is what keeps
                                         the shared column from resizing every row the
                                         moment one download starts, and keeps the row
                                         height constant while it runs. -->
                                    <!-- No fixed height: with every state measured, the
                                         cell is already the height of the tallest of them
                                         whichever one is showing, and pinning it would
                                         only risk squashing a button. -->
                                    <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                          MinWidth="112">
                                        <ui:Button x:Name="DownloadButton" Content="{Binding DownloadActionText}"
                                                   Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Secondary"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                   HorizontalContentAlignment="Center" Padding="10,0"
                                                   Command="{Binding DataContext.DownloadDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibleOrHiddenConverter}}"/>

                                        <!-- In flight. The whole chip is the cancel
                                             target, so no second control is needed and
                                             nothing has to make room for one: the caption
                                             turns from the percentage into Cancel under
                                             the pointer. The fill is a ProgressLine, which
                                             animates a scale transform on the composition
                                             thread - it cannot cause a layout pass, so a
                                             download running in one row can never nudge
                                             the rest of the page. -->
                                        <Button x:Name="DownloadProgressChip"
                                                Style="{StaticResource DriverProgressChipStyle}"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                ToolTip="Cancel"
                                                Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibleOrHiddenConverter}}"/>

                                        <ui:Button x:Name="InstallButton"
                                                   Content="Install" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                   HorizontalContentAlignment="Center" Padding="10,0"
                                                   Command="{Binding DataContext.InstallDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibleOrHiddenConverter}}"/>

                                        <ui:Button x:Name="RetryButton"
                                                   Content="Retry" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Secondary"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                   HorizontalContentAlignment="Center" Padding="10,0"
                                                   Command="{Binding DataContext.DownloadDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibleOrHiddenConverter}}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:UpdateState.Outdated}">
                                    <Setter TargetName="StateBar" Property="Background" Value="{DynamicResource StatusWarning}"/>
                                    <Setter TargetName="IconTint" Property="Background" Value="{DynamicResource StatusWarning}"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusWarning}"/>
                                    <Setter TargetName="StatusIcon" Property="Symbol" Value="ArrowDownload24"/>
                                    <Setter TargetName="StatusPillTint" Property="Background" Value="{DynamicResource StatusWarning}"/>
                                    <Setter TargetName="StatusPillStroke" Property="BorderBrush" Value="{DynamicResource StatusWarning}"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource StatusWarning}"/>
                                    <Setter TargetName="DownloadButton" Property="Appearance" Value="Primary"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:UpdateState.UpToDate}">
                                    <Setter TargetName="StateBar" Property="Background" Value="{DynamicResource StatusSuccess}"/>
                                    <Setter TargetName="IconTint" Property="Background" Value="{DynamicResource StatusSuccess}"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusSuccess}"/>
                                    <Setter TargetName="StatusIcon" Property="Symbol" Value="CheckmarkCircle24"/>
                                    <Setter TargetName="StatusPillTint" Property="Background" Value="{DynamicResource StatusSuccess}"/>
                                    <Setter TargetName="StatusPillStroke" Property="BorderBrush" Value="{DynamicResource StatusSuccess}"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource StatusSuccess}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:UpdateState.Newer}">
                                    <Setter TargetName="StateBar" Property="Background" Value="{DynamicResource StatusSuccess}"/>
                                    <Setter TargetName="IconTint" Property="Background" Value="{DynamicResource StatusSuccess}"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusSuccess}"/>
                                    <Setter TargetName="StatusIcon" Property="Symbol" Value="ArrowTrending24"/>
                                    <Setter TargetName="StatusPillTint" Property="Background" Value="{DynamicResource StatusSuccess}"/>
                                    <Setter TargetName="StatusPillStroke" Property="BorderBrush" Value="{DynamicResource StatusSuccess}"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource StatusSuccess}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:UpdateState.Unknown}">
                                    <Setter TargetName="StateBar" Property="Background" Value="{DynamicResource StatusCritical}"/>
                                    <Setter TargetName="IconTint" Property="Background" Value="{DynamicResource StatusCritical}"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusCritical}"/>
                                    <Setter TargetName="StatusIcon" Property="Symbol" Value="Warning24"/>
                                    <Setter TargetName="StatusPillTint" Property="Background" Value="{DynamicResource StatusCritical}"/>
                                    <Setter TargetName="StatusPillStroke" Property="BorderBrush" Value="{DynamicResource StatusCritical}"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource StatusCritical}"/>
                                </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource StrokeSubtle}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="24"
                    Visibility="{Binding VisibleDrivers.Count, Converter={StaticResource EmptyCountToVisibleConverter}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                    <Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Border Background="{DynamicResource AccentPrimary}" Opacity="0.12" CornerRadius="10"/>
                        <ui:SymbolIcon Symbol="Search24" Foreground="{DynamicResource AccentPrimary}" FontSize="22"/>
                    </Grid>
                    <TextBlock Text="No drivers in this view" Style="{StaticResource SettingLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Run a scan, or choose another filter to see the matching ASUS packages."
                               Style="{StaticResource SettingDescriptionStyle}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
