<UserControl x:Class="Arsenal.UI.Views.Pages.AdvancedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Arsenal.UI.Controls"
             xmlns:loc="clr-namespace:Arsenal.UI.Markup">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel Style="{StaticResource PageBodyStyle}">

            <Grid Style="{StaticResource PageHeaderStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="{loc:Loc AdvancedAdvanced}" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="{loc:Loc AdvancedPowerUserControlsForFirmware}" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource ActionBarStyle}">
                    <ui:Button Style="{StaticResource ActionButtonStyle}" Margin="0" Content="{loc:Loc AdvancedSaveChanges}" Command="{Binding SaveSystemTweaksCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"/>
                </StackPanel>
            </Grid>

            <ui:InfoBar Title="{loc:Loc AdvancedUseWithCare}"
                        Message="These controls change firmware-facing behaviour and Windows power policy. Options your model does not support are ignored by the hardware backend."
                        Severity="Warning" IsOpen="True" IsClosable="False"
                        Margin="{StaticResource SectionGap}"/>

            <controls:SettingsGroup Header="{loc:Loc AdvancedPermissions}" Icon="ShieldTask24"
                                    Description="{loc:Loc AdvancedSomeFirmwareAndWindowsSettings}"
                                    Visibility="{Binding NeedsElevation, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsRow Header="{loc:Loc AdvancedRunningWithoutAdministrator}"
                                      Description="{loc:Loc AdvancedTheBatteryIconSSmart}">
                    <ui:Button Style="{StaticResource ActionButtonStyle}" Margin="0" Content="{loc:Loc AdvancedRestartAsAdministrator}"
                               Command="{Binding RestartAsAdministratorCommand}" Appearance="Primary"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc AdvancedASUSServicesAndKeyboard}" Icon="Wrench24">
                <controls:SettingsRow Header="{loc:Loc AdvancedASUSBackgroundServices}"
                                      Description="{loc:Loc AdvancedStopOrStartASUSOptimization}">
                    <!-- Deliberately not a switch. Starting and stopping services is an
                         operation: it takes time, it can need elevation, and it can fail.
                         A switch would claim it had happened the moment it was moved. The
                         pill says where the services are; the button names the one action
                         available from there, and neither is offered mid-flight. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Same tint-plus-stroke pill the driver list uses for its
                             package states, so a status reads the same way across pages. -->
                        <Grid Margin="0,0,10,0" VerticalAlignment="Center"
                              Visibility="{Binding AsusOptimizationRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Background="{DynamicResource StatusSuccess}" Opacity="0.14" CornerRadius="10"/>
                            <Border BorderBrush="{DynamicResource StatusSuccess}" BorderThickness="1" CornerRadius="10" Padding="9,2">
                                <TextBlock Text="{loc:Loc AdvancedServicesRunning}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource StatusSuccess}"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,10,0" VerticalAlignment="Center"
                              Visibility="{Binding AsusOptimizationRunning, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Border Background="{DynamicResource TextSecondary}" Opacity="0.12" CornerRadius="10"/>
                            <Border BorderBrush="{DynamicResource TextSecondary}" BorderThickness="1" CornerRadius="10" Padding="9,2">
                                <TextBlock Text="{loc:Loc AdvancedServicesStopped}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Border>
                        </Grid>

                        <Grid MinWidth="128">
                            <ui:Button x:Name="StopAsusServicesButton"
                                       Content="{loc:Loc AdvancedStopServices}" Icon="{ui:SymbolIcon Stop24}"
                                       Appearance="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                       Command="{Binding StopAsusServicesCommand}"
                                       Visibility="{Binding CanStopAsusServices, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <ui:Button x:Name="StartAsusServicesButton"
                                       Content="{loc:Loc AdvancedStartServices}" Icon="{ui:SymbolIcon Play24}"
                                       Appearance="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                       Command="{Binding StartAsusServicesCommand}"
                                       Visibility="{Binding CanStartAsusServices, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- The services take a moment to settle either way, and the
                                 answer is re-read from the service manager afterwards, so
                                 the wait is real and is shown rather than hidden. -->
                            <ui:Button x:Name="AsusServicesBusyButton"
                                       IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                       Appearance="Secondary"
                                       Visibility="{Binding IsAsusServiceOperationRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:Loc AdvancedServicesWorking}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </StackPanel>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedFnLock}" Description="{loc:Loc AdvancedInvertTheDefaultBehaviourOf}">
                    <ui:ToggleSwitch IsChecked="{Binding FnLockEnabled}" Command="{Binding ToggleFnLockCommand}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedStatusLEDs}" Description="{loc:Loc AdvancedASUSKeyboardAndChassisStatus}"
                                      Visibility="{Binding HasStatusLed, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding StatusLedEnabled}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedNumberPad}" Description="{loc:Loc AdvancedTheTouchpadNumberPadOnModels}"
                                      Visibility="{Binding HasNumberPad, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding NumberPadEnabled}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc AdvancedHardwareOverlay}" Icon="DataUsage24">
                <controls:SettingsRow Header="{loc:Loc AdvancedOnScreenHardwareMonitor}"
                                      Description="{loc:Loc AdvancedLowOverheadCPUGPUFan}">
                    <ui:ToggleSwitch IsChecked="{Binding HardwareOverlayEnabled}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedOnlyWhileGaming}"
                                      Description="{loc:Loc AdvancedHideTheOverlayAutomatically}">
                    <ui:ToggleSwitch IsChecked="{Binding OverlayGameOnly}"
                                     IsEnabled="{Binding HardwareOverlayEnabled}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc AdvancedROGAlly}" Icon="XboxController24"
                                    Visibility="{Binding HasHandheldControls, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsRow Header="{loc:Loc AdvancedAutomaticTDP}" Description="{loc:Loc AdvancedAdaptAPUPowerToThe}">
                    <ui:ToggleSwitch IsChecked="{Binding AutoTdpEnabled}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedFrameRateLimit}" Description="{loc:Loc AdvancedCycleTheAMDFrameRate}">
                    <ui:Button Content="{Binding FpsLimit, StringFormat='{}{0} FPS'}"
                               Command="{Binding CycleFpsLimitCommand}" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc AdvancedPowerAndGraphicsPolicy}" Icon="PlugConnected24">
                <controls:SettingsRow Header="{loc:Loc AdvancedPCIeLinkPowerManagement}"
                                      Description="{loc:Loc AdvancedASPMLetBalancedPowerPlans}">
                    <ui:ToggleSwitch IsChecked="{Binding AspmEnabled}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedStandbyNetworking}"
                                      Description="{loc:Loc AdvancedKeepNetworkConnectivityAvailable}">
                    <ui:ToggleSwitch IsChecked="{Binding StandbyNetworkingEnabled}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedNVIDIAPlatformController}"
                                      Description="{loc:Loc AdvancedKeepNVIDIAPlatformBehaviour}">
                    <ui:ToggleSwitch IsChecked="{Binding NvidiaPlatformEnabled}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedCloseAppsBeforeEcoMode}"
                                      Description="{loc:Loc AdvancedCloseApplicationsHoldingTheDGPU}">
                    <ui:ToggleSwitch IsChecked="{Binding KillGpuAppsEnabled}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedOptimizedModeOnUSBC}"
                                      Description="{loc:Loc AdvancedAllowAutomaticGPUSwitchingWhile}">
                    <ui:ToggleSwitch IsChecked="{Binding OptimizedUsbCEnabled}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedDisablePanelOverdriveAutomation}"
                                      Description="{loc:Loc AdvancedStopOverdriveFromChanging}">
                    <ui:ToggleSwitch IsChecked="{Binding DisableOverdrive}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedForcePanelOverdrive}"
                                      Description="{loc:Loc AdvancedShowAndWriteOverdriveEven}">
                    <ui:ToggleSwitch IsChecked="{Binding ForceOverdrive}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc AdvancedSleepLidAndWindowBehaviour}" Icon="Sleep24">
                <controls:SettingsRow Header="{loc:Loc AdvancedAutomaticClamshellMode}"
                                      Description="{loc:Loc AdvancedStayAwakeWithTheLid}">
                    <ui:ToggleSwitch IsChecked="{Binding AutoClamshellEnabled}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedBootSound}" Description="{loc:Loc AdvancedTheFirmwareStartupSoundOn}">
                    <ui:ToggleSwitch IsChecked="{Binding BootSoundEnabled}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedAlwaysOnTop}" Description="{loc:Loc AdvancedKeepTheArsenalWindowAbove}">
                    <ui:ToggleSwitch IsChecked="{Binding AlwaysOnTop}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedHibernateAfter}" Description="{loc:Loc AdvancedZeroLeavesTheWindowsSetting}">
                    <controls:ValueSlider Minimum="0" Maximum="{Binding HibernateAfterMaximum}" TickFrequency="5" IsSnapToTickEnabled="True"
                                          Value="{Binding HibernateAfterMinutes}" Format="{}{0} min"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedBacklightTimeoutBattery}">
                    <controls:ValueSlider Minimum="0" Maximum="{Binding KeyboardTimeoutMaximum}" TickFrequency="15" IsSnapToTickEnabled="True"
                                          Value="{Binding KeyboardTimeoutSeconds}" Format="{}{0} s"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedBacklightTimeoutAC}">
                    <controls:ValueSlider Minimum="0" Maximum="{Binding KeyboardAcTimeoutMaximum}" TickFrequency="15" IsSnapToTickEnabled="True"
                                          Value="{Binding KeyboardAcTimeoutSeconds}" Format="{}{0} s"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc AdvancedDiagnostics}" Icon="Document24">
                <controls:SettingsRow Header="{loc:Loc AdvancedWindowsPowerOptions}" Description="{loc:Loc AdvancedOpensTheSystemPowerPlan}">
                    <ui:Button Content="{loc:Loc AdvancedOpen}" Command="{Binding OpenPowerPlanSettingsCommand}" Appearance="Secondary" Icon="{ui:SymbolIcon Open24}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc AdvancedArsenalLog}" Description="{loc:Loc AdvancedTheApplicationLogUsefulWhen}">
                    <ui:Button Content="{loc:Loc AdvancedOpen}" Command="{Binding OpenLogCommand}" Appearance="Secondary" Icon="{ui:SymbolIcon Open24}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

        </StackPanel>
    </ScrollViewer>
</UserControl>
