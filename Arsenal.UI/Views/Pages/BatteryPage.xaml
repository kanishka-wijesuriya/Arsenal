<UserControl x:Class="Arsenal.UI.Views.Pages.BatteryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Arsenal.UI.Controls"
             xmlns:vm="clr-namespace:Arsenal.UI.ViewModels"
>
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel Style="{StaticResource PageBodyStyle}">

            <Grid Style="{StaticResource PageHeaderStyle}">
                <StackPanel>
                    <TextBlock Text="Battery" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Charge limits, live power telemetry and battery health" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Stands aside with the groups when one of them is opened. These summarise
                 the page, and a subpage is not this page. -->
            <controls:ResponsiveGrid MinItemWidth="200" MaxColumns="3" Margin="-5,0,-5,15"
                                     controls:SettingsGroup.HideInSubpage="True">
                <controls:MetricTile Icon="BatteryCharge24"
                                     Label="Charge"
                                     Value="{Binding BatteryPercent, StringFormat='{}{0}%'}"
                                     Progress="{Binding BatteryPercent}"
                                     ProgressCap="{Binding EffectiveChargeLimit}"
                                     ShowProgress="True"
                                     Detail="{Binding ChargeStopsAtText}"
                                     DetailIcon="ShieldCheckmark24"/>
                <controls:MetricTile Icon="{Binding PowerFlowIcon}"
                                     Label="{Binding PowerFlowLabel}"
                                     Value="{Binding PowerFlowValue}"
                                     Detail="{Binding TimeToFullText}"
                                     DetailIcon="BatteryCharge24"
                                     SecondaryDetail="{Binding TimeToEmptyText}"
                                     SecondaryDetailIcon="Timer24"/>
                <controls:MetricTile Icon="Heart24"
                                     Label="Battery health"
                                     Value="{Binding BatteryHealth}"
                                     Detail="{Binding BatteryHealthDetail}"/>
            </controls:ResponsiveGrid>

            <controls:SettingsGroup Header="Charge limit" Icon="BatteryCharge24"
                                    Description="Stopping the charge below 100% while plugged in is the single biggest thing you can do for long-term battery health.">
                <controls:SettingsRow Header="Windows is not showing smart charging"
                                      Description="The limit below is applied to the battery firmware and is working. Reporting it to Windows, which is what puts the leaf on the battery icon, writes to a machine-wide setting that needs administrator rights."
                                      Visibility="{Binding NeedsElevation, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:Button Style="{DynamicResource ActionButtonStyle}" Margin="0"
                               Content="Restart as administrator"
                               Command="{Binding RestartAsAdministratorCommand}" Appearance="Primary"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Maximum charge level" Description="{Binding ChargeLimitNote}">
                    <controls:ValueSlider Minimum="{Binding ChargeLimitMinimum}" Maximum="100"
                                          Ticks="{Binding ChargeLimitTicks}"
                                          IsSnapToTickEnabled="{Binding HasSteppedChargeLimit}"
                                          Marks="{Binding ChargeLimitMarks}"
                                          Value="{Binding ChargeLimit}" Format="{}{0}%"
                                          PreviewMouseLeftButtonUp="ChargeLimitSlider_Commit"
                                          KeyUp="ChargeLimitSlider_KeyUp"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Presets">
                    <controls:SettingsRow.ContentBelow>
                        <WrapPanel Style="{StaticResource ChoiceGroupStyle}">
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="ChargeLimit" Content="60% · desk" MinWidth="150"
                                         IsChecked="{Binding ChargeLimit, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=60}"
                                         Command="{Binding SetLimitCommand}" CommandParameter="60"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="ChargeLimit" Content="80% · recommended" MinWidth="150"
                                         IsChecked="{Binding ChargeLimit, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=80}"
                                         Command="{Binding SetLimitCommand}" CommandParameter="80"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="ChargeLimit" Content="100% · travel" MinWidth="150"
                                         IsChecked="{Binding ChargeLimit, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=100}"
                                         Command="{Binding SetLimitCommand}" CommandParameter="100"/>
                        </WrapPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="One-time full charge"
                                      Description="Charge to 100% for this trip without changing the saved limit.">
                    <ui:ToggleSwitch IsChecked="{Binding IsFullChargeOverride}" Command="{Binding ToggleFullChargeCommand}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="Diagnostics" Icon="Document24"
                                    Description="What Windows has recorded about this battery: how much it still holds, and how that has changed.">
                <controls:SettingsRow Header="Battery report"
                                      Description="Runs the same scan Windows does and reads it here. Takes a few seconds.">
                    <ui:Button Content="{Binding IsBuildingReport, Converter={StaticResource BoolToTextConverter}, ConverterParameter=Reading the report…|Generate report}"
                               Command="{Binding GenerateReportCommand}"
                               IsEnabled="{Binding IsBuildingReport, Converter={StaticResource InverseBoolConverter}}"
                               Appearance="Primary" Icon="{ui:SymbolIcon DocumentBulletList24}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Visibility="{Binding ReportError, Converter={StaticResource HideWhenEmptyText}}">
                    <controls:SettingsRow.ContentBelow>
                        <TextBlock Text="{Binding ReportError}" Style="{StaticResource SettingDescriptionStyle}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <!-- The report itself. Four readings and the line they came from: what
                     the battery holds now against what it was built to hold, and whether
                     that has been moving. The full Windows document stays one click
                     away for the rest of it. -->
                <controls:SettingsRow Visibility="{Binding HasReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SettingsRow.ContentBelow>
                        <StackPanel>
                            <controls:ResponsiveGrid MinItemWidth="190" MaxColumns="4" Margin="-5,0,-5,14">
                                <controls:MetricTile Icon="Heart24"
                                                     Label="Health"
                                                     Value="{Binding ReportHealth}"
                                                     Detail="{Binding ReportHealthDetail}"/>
                                <controls:MetricTile Icon="BatteryCharge24"
                                                     Label="Holds now"
                                                     Value="{Binding ReportCapacity}"
                                                     Detail="{Binding ReportCapacityDetail}"/>
                                <controls:MetricTile Icon="ArrowSync24"
                                                     Label="Cycles"
                                                     Value="{Binding ReportCycles}"
                                                     Detail="{Binding ReportCyclesDetail}"/>
                                <controls:MetricTile Icon="Timer24"
                                                     Label="Estimated runtime"
                                                     Value="{Binding ReportRuntime}"
                                                     Detail="{Binding ReportRuntimeDetail}"/>
                            </controls:ResponsiveGrid>

                            <TextBlock Text="Capacity over time" Style="{StaticResource SettingLabelStyle}"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding ReportHistoryCaption}" Style="{StaticResource SettingDescriptionStyle}"
                                       TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"/>

                            <Border CornerRadius="{DynamicResource RadiusCard}"
                                    Background="{DynamicResource SurfaceSunken}"
                                    BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"
                                    Padding="14,12" Margin="0,10,0,0">
                                <controls:CapacityHistoryChart Height="150" Points="{Binding ReportHistory}"/>
                            </Border>

                            <WrapPanel Margin="0,14,-10,-10">
                                <Border Style="{StaticResource InsetSettingChipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Chemistry" Style="{StaticResource CaptionStyle}"/>
                                        <TextBlock Text="{Binding ReportChemistry}" Style="{StaticResource SettingLabelStyle}"
                                                   HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetSettingChipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Report" Style="{StaticResource CaptionStyle}"/>
                                        <TextBlock Text="{Binding ReportScanned}" Style="{StaticResource SettingLabelStyle}"
                                                   HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <ui:Button Content="Open the full Windows report"
                                       Command="{Binding OpenFullReportCommand}"
                                       Visibility="{Binding CanOpenFullReport, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Appearance="Secondary" Icon="{ui:SymbolIcon Open24}"
                                       HorizontalAlignment="Left" Margin="0,16,0,0"/>
                        </StackPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>
            </controls:SettingsGroup>

        </StackPanel>
    </ScrollViewer>
</UserControl>
