<UserControl x:Class="Arsenal.UI.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Arsenal.UI.Controls"
             xmlns:loc="clr-namespace:Arsenal.UI.Markup">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel Style="{StaticResource PageBodyStyle}">

            <Grid Style="{StaticResource PageHeaderStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc SettingsSettings}" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="{loc:Loc SettingsStartupTrayBehaviourAppearance}" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
            </Grid>

            <controls:SettingsGroup Header="{loc:Loc SettingsApplication}" Icon="Settings24">
                <controls:SettingsRow Header="{loc:Loc SetupRunAsAdministrator}"
                                      Description="{Binding AdministratorDescription}">
                    <ui:ToggleSwitch IsChecked="{Binding RunAsAdministrator, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc SettingsRunAtWindowsSignIn}"
                                      Description="{loc:Loc SettingsRegistersASignInTask}">
                    <ui:ToggleSwitch IsChecked="{Binding RunOnStartup, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc SettingsSetup}"
                                      Description="{loc:Loc SettingsStartupNotificationsUpdatesAnd}">
                    <ui:Button Style="{StaticResource ActionButtonStyle}" Margin="0"
                               Content="{loc:Loc SettingsRunSetupAgain}" Appearance="Secondary"
                               Command="{Binding RunSetupCommand}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc SettingsMinimiseToTrayOnClose}"
                                      Description="{loc:Loc SettingsKeepsHotkeysAutomationAnd}">
                    <ui:ToggleSwitch IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc SettingsCheckForUpdatesAtStartup}"
                                      Description="{loc:Loc SettingsUsesArsenalSUpdateChannel}"
                                      Visibility="{Binding CanSelfUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding CheckUpdatesOnStartup, Mode=TwoWay}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc SettingsAppearance}" Icon="Color24">
                <controls:SettingsRow Header="{loc:Loc SettingsTheme}"
                                      Description="{loc:Loc SettingsAppliesImmediatelySystemMode}">
                    <WrapPanel Style="{StaticResource RowChoiceGroupStyle}">
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="Theme" Content="{loc:Loc SettingsSystem}"
                                     IsChecked="{Binding SelectedTheme, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="0"/>
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="Theme" Content="{loc:Loc SettingsDark}"
                                     IsChecked="{Binding SelectedTheme, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="1"/>
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="Theme" Content="{loc:Loc SettingsLight}"
                                     IsChecked="{Binding SelectedTheme, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="2"/>
                    </WrapPanel>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc SettingsDisableTransparency}"
                                      Description="{loc:Loc SettingsDisableTransparencyDescription}">
                    <ui:ToggleSwitch IsChecked="{Binding DisableTransparency, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc SettingsAccentColour}"
                                      Description="{Binding AccentDescription}">
                    <WrapPanel Style="{StaticResource RowChoiceGroupStyle}">
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="AccentSource"
                                     Content="{loc:Loc SettingsWindows}"
                                     IsChecked="{Binding SelectedAccentSource, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                     Command="{Binding SetAccentSourceCommand}" CommandParameter="0"/>
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="AccentSource"
                                     Content="{loc:Loc Custom}"
                                     IsChecked="{Binding SelectedAccentSource, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                     Command="{Binding SetAccentSourceCommand}" CommandParameter="1"/>
                    </WrapPanel>

                    <!-- The picker stays on its own line: it is an editor, not a choice,
                         and it only exists while Custom is selected. -->
                    <controls:SettingsRow.ContentBelow>
                        <Border Style="{StaticResource InsetSurfaceStyle}"
                                Width="420" Padding="16" Margin="0,4,0,0"
                                HorizontalAlignment="Left"
                                Visibility="{Binding IsCustomAccent, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <controls:ColorSpectrumPicker Height="190"
                                                              SelectedColor="{Binding CustomAccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="32" Height="32" Margin="0,0,10,0"
                                            Background="{Binding CustomAccentBrush}"
                                            BorderBrush="{DynamicResource StrokeSubtle}"
                                            BorderThickness="1" CornerRadius="6"/>
                                    <TextBox Grid.Column="1" Width="104" Height="32"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding CustomAccentHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ui:Button Grid.Column="2" Height="32" Margin="8,0,0,0"
                                               Content="{loc:Loc SettingsApplyHex}" Appearance="Secondary"
                                               Command="{Binding ApplyCustomAccentHexCommand}"/>
                                </Grid>

                                <TextBlock Margin="0,10,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextTertiary}"
                                           Text="{loc:Loc SettingsDragAnywhereInTheSpectrum}"/>
                            </StackPanel>
                        </Border>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc SettingsLanguage}" Description="{loc:Loc SettingsRestartArsenalAfterChangingThe}">
                    <ComboBox ItemsSource="{Binding AvailableLanguages}" DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguageCode}"
                              SelectionChanged="Language_SelectionChanged" MinWidth="240"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc SettingsNotifications}" Icon="Alert24"
                                    Description="{loc:Loc SettingsFloatingFeedbackShownFor}">
                <controls:SettingsRow Header="{loc:Loc SettingsShowFloatingNotifications}">
                    <ui:ToggleSwitch IsChecked="{Binding ToastEnabled, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc SettingsDesign}" IsEnabled="{Binding ToastEnabled}">
                    <ComboBox ItemsSource="{Binding ToastStyles}" SelectedIndex="{Binding ToastStyle, Mode=TwoWay}" MinWidth="240"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc SettingsLocation}" IsEnabled="{Binding ToastEnabled}">
                    <ComboBox ItemsSource="{Binding ToastPositions}" SelectedIndex="{Binding ToastPosition, Mode=TwoWay}" MinWidth="240"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc SettingsVisibleDuration}" IsEnabled="{Binding ToastEnabled}">
                    <controls:ValueSlider Minimum="2" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                                          Value="{Binding ToastDurationSeconds, Mode=TwoWay}" Format="{}{0} s"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc SettingsCountdownBar}"
                                      Description="{loc:Loc SettingsDrawAThinBarShowing}"
                                      IsEnabled="{Binding ToastEnabled}">
                    <ui:ToggleSwitch IsChecked="{Binding ToastProgress, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsGroup.Footer>
                    <ui:Button Content="{loc:Loc SettingsPreviewNotification}" Icon="{ui:SymbolIcon Alert24}" Command="{Binding TestToastCommand}"
                               Appearance="Secondary" HorizontalAlignment="Left"
                               IsEnabled="{Binding ToastEnabled}"/>
                </controls:SettingsGroup.Footer>
            </controls:SettingsGroup>

        </StackPanel>
    </ScrollViewer>
</UserControl>
