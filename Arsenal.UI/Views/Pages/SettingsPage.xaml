<UserControl x:Class="Arsenal.UI.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Arsenal.UI.Controls"
>
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel Style="{StaticResource PageBodyStyle}">

            <Grid Style="{StaticResource PageHeaderStyle}">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Startup, tray behaviour, appearance and notifications" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
            </Grid>

            <controls:SettingsGroup Header="Application" Icon="Settings24"
                                    Description="How Arsenal starts, whether it stays in the tray, and when it looks for updates.">
                <controls:SettingsRow Header="Run as administrator"
                                      Description="{Binding AdministratorDescription}">
                    <ui:ToggleSwitch IsChecked="{Binding RunAsAdministrator, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Run at Windows sign-in"
                                      Description="Registers a sign-in task using the administrator preference above. Elevated sign-in starts do not show a UAC prompt.">
                    <ui:ToggleSwitch IsChecked="{Binding RunOnStartup, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Start minimised"
                                      Description="Keeps a normal launch in the system tray. Opening a specific Arsenal page still shows the app.">
                    <ui:ToggleSwitch IsChecked="{Binding StartMinimized, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Setup"
                                      Description="Startup, notifications, updates and ASUS services, in one place.">
                    <ui:Button Style="{DynamicResource ActionButtonStyle}" Margin="0"
                               Content="Run setup again" Appearance="Secondary"
                               Command="{Binding RunSetupCommand}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Minimise to tray on close"
                                      Description="Keeps hotkeys, automation and hardware monitoring running.">
                    <ui:ToggleSwitch IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Check for updates at startup"
                                      Description="Uses Arsenal's update channel in the background."
                                      Visibility="{Binding CanSelfUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding CheckUpdatesOnStartup, Mode=TwoWay}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="Appearance" Icon="Color24"
                                    Description="Theme, accent colour and whether the window paints on a transparent backdrop.">
                <controls:SettingsRow Header="Theme"
                                      Description="Applies immediately. System mode follows Windows from the next theme change.">
                    <WrapPanel Style="{StaticResource RowChoiceGroupStyle}">
                        <RadioButton Style="{DynamicResource RowSegmentStyle}" GroupName="Theme" Content="System"
                                     IsChecked="{Binding SelectedTheme, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="0"/>
                        <RadioButton Style="{DynamicResource RowSegmentStyle}" GroupName="Theme" Content="Dark"
                                     IsChecked="{Binding SelectedTheme, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="1"/>
                        <RadioButton Style="{DynamicResource RowSegmentStyle}" GroupName="Theme" Content="Light"
                                     IsChecked="{Binding SelectedTheme, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="2"/>
                        <RadioButton Style="{DynamicResource RowSegmentStyle}" GroupName="Theme" Content="Arsenal"
                                     IsChecked="{Binding SelectedTheme, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="3"/>
                    </WrapPanel>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Open sections as subpages"
                                      Description="Each section on a page becomes a card you press, and opens onto a page of its own with its name in the title bar. Turn this off to show every section at once, down one long page. Applies to whichever theme you are using.">
                    <ui:ToggleSwitch IsChecked="{Binding UseSubpages, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Disable transparency"
                                      Description="Turns off the Mica backdrop for Arsenal only and paints the window on flat colours. Windows transparency elsewhere is unaffected.">
                    <ui:ToggleSwitch IsChecked="{Binding DisableTransparency, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Accent colour"
                                      Description="{Binding AccentDescription}">
                    <WrapPanel Style="{StaticResource RowChoiceGroupStyle}">
                        <RadioButton Style="{DynamicResource RowSegmentStyle}" GroupName="AccentSource"
                                     Content="Windows"
                                     IsChecked="{Binding SelectedAccentSource, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                     Command="{Binding SetAccentSourceCommand}" CommandParameter="0"/>
                        <RadioButton Style="{DynamicResource RowSegmentStyle}" GroupName="AccentSource"
                                     Content="Custom"
                                     IsChecked="{Binding SelectedAccentSource, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                     Command="{Binding SetAccentSourceCommand}" CommandParameter="1"/>
                    </WrapPanel>

                    <!-- The picker stays on its own line: it is an editor, not a choice,
                         and it only exists while Custom is selected. -->
                    <controls:SettingsRow.ContentBelow>
                        <Border Style="{StaticResource InsetSurfaceStyle}"
                                Width="420" Padding="16" Margin="0,4,0,0"
                                HorizontalAlignment="Left"
                                Visibility="{Binding IsCustomAccent, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <controls:ColorSpectrumPicker Height="190"
                                                              SelectedColor="{Binding CustomAccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="32" Height="32" Margin="0,0,10,0"
                                            Background="{Binding CustomAccentBrush}"
                                            BorderBrush="{DynamicResource StrokeSubtle}"
                                            BorderThickness="1" CornerRadius="6"/>
                                    <TextBox Grid.Column="1" Width="104" Height="32"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding CustomAccentHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ui:Button Grid.Column="2" Height="32" Margin="8,0,0,0"
                                               Content="Apply hex" Appearance="Secondary"
                                               Command="{Binding ApplyCustomAccentHexCommand}"/>
                                </Grid>

                                <TextBlock Margin="0,10,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextTertiary}"
                                           Text="Drag anywhere in the spectrum. Every Arsenal window updates live."/>
                            </StackPanel>
                        </Border>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

            </controls:SettingsGroup>

            <controls:SettingsGroup Header="Notifications" Icon="Alert24"
                                    Description="Floating feedback shown for brightness, mode, hotkey and hardware actions.">
                <controls:SettingsRow Header="Show floating notifications">
                    <ui:ToggleSwitch IsChecked="{Binding ToastEnabled, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Design" IsEnabled="{Binding ToastEnabled}">
                    <ComboBox ItemsSource="{Binding ToastStyles}" SelectedIndex="{Binding ToastStyle, Mode=TwoWay}" MinWidth="240"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Location" IsEnabled="{Binding ToastEnabled}">
                    <ComboBox ItemsSource="{Binding ToastPositions}" SelectedIndex="{Binding ToastPosition, Mode=TwoWay}" MinWidth="240"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Visible duration" IsEnabled="{Binding ToastEnabled}">
                    <controls:ValueSlider Minimum="2" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                                          Value="{Binding ToastDurationSeconds, Mode=TwoWay}" Format="{}{0} s"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Countdown bar"
                                      Description="Draw a thin bar showing how long the notification has left."
                                      IsEnabled="{Binding ToastEnabled}">
                    <ui:ToggleSwitch IsChecked="{Binding ToastProgress, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsGroup.Footer>
                    <ui:Button Content="Preview notification" Icon="{ui:SymbolIcon Alert24}" Command="{Binding TestToastCommand}"
                               Appearance="Secondary" HorizontalAlignment="Left"
                               IsEnabled="{Binding ToastEnabled}"/>
                </controls:SettingsGroup.Footer>
            </controls:SettingsGroup>

        </StackPanel>
    </ScrollViewer>
</UserControl>
