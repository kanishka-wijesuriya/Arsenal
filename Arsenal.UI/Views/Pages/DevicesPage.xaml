<UserControl x:Class="Arsenal.UI.Views.Pages.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Arsenal.UI.Controls"
             xmlns:vm="clr-namespace:Arsenal.UI.ViewModels"
>
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel Style="{StaticResource PageBodyStyle}">

            <Grid Style="{StaticResource PageHeaderStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Devices" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="ASUS mice, keyboards, Omni Receiver peripherals and handheld controls" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource ActionBarStyle}">
                    <ui:Button Style="{DynamicResource ActionButtonStyle}" Margin="0" Content="Scan for devices" Command="{Binding RefreshDevicesCommand}" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}"/>
                </StackPanel>
            </Grid>

            <controls:SettingsGroup Header="Connected peripherals" Icon="Keyboard24"
                                    Description="Select a device to edit the onboard profile written to its own memory.">
                <controls:SettingsRow>
                    <controls:SettingsRow.ContentBelow>
                      <StackPanel>
                        <TextBlock Text="No ASUS peripherals detected. Connect one, then run Scan for devices."
                                   Style="{StaticResource CaptionStyle}"
                                   Visibility="{Binding Devices.Count, Converter={StaticResource EmptyCountToVisibleConverter}}"/>
                        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetSurfaceStyle}" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon x:Name="DeviceIcon" Symbol="Cursor24" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentPrimary}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SettingLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SettingDescriptionStyle}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding BatteryText}"
                                                       VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboard}" Value="True">
                                            <Setter TargetName="DeviceIcon" Property="Symbol" Value="Keyboard24"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="Mouse performance" Icon="Gauge24"
                                    Description="Changes are written to the selected device's onboard profile when you apply them."
                                    Visibility="{Binding IsMouseSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Both tracks are drawn from the selected mouse rather than from a range
                     wide enough to cover every mouse: the service clamps DPI to the
                     sensor's own bounds and snaps the rate to one the device reports at,
                     so anything else on the track is unreachable. -->
                <controls:SettingsRow Header="DPI">
                    <controls:ValueSlider Minimum="{Binding SelectedDevice.MinDpi}" Maximum="{Binding SelectedDevice.MaxDpi}"
                                          TickFrequency="{Binding SelectedDevice.DpiStep}" IsSnapToTickEnabled="True"
                                          Value="{Binding DeviceDpi}" Format="{}{0}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Polling rate" Description="Higher rates report position more often at the cost of battery life."
                                      IsEnabled="{Binding HasPollingRateChoice}">
                    <controls:ValueSlider Minimum="{Binding DevicePollingRateMinimum}" Maximum="{Binding DevicePollingRateMaximum}"
                                          Ticks="{Binding DevicePollingRateTicks}" IsSnapToTickEnabled="True"
                                          Value="{Binding DevicePollingRate}" Format="{}{0} Hz"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Sleep timeout" Description="Idle time before the device powers down its sensor.">
                    <ComboBox ItemsSource="{Binding SleepTimeoutOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding DeviceSleepMinutes, Mode=TwoWay}" MinWidth="240"/>
                </controls:SettingsRow>

                <controls:SettingsGroup.Footer>
                    <ui:Button Content="Apply to device" Command="{Binding ApplyDeviceSettingsCommand}" Appearance="Primary"
                               HorizontalAlignment="Right" Icon="{ui:SymbolIcon Save24}"/>
                </controls:SettingsGroup.Footer>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="Keyboard lighting" Icon="Color24"
                                    Description="Configure the selected keyboard's onboard lighting mode, colors, speed and brightness."
                                    Visibility="{Binding SelectedDevice.HasKeyboardLighting, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsRow Header="Sync with laptop Aura" Description="Mirror the laptop keyboard colour while keeping effects hardware-driven.">
                    <ui:ToggleSwitch IsChecked="{Binding KeyboardAuraSync, Mode=TwoWay}"/>
                </controls:SettingsRow>
                <controls:SettingsRow Header="Lighting Mode">
                    <ComboBox IsEnabled="{Binding IsKeyboardManualLighting}" ItemsSource="{Binding SelectedDevice.LightingModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding KeyboardLightingMode, Mode=TwoWay}" MinWidth="240"/>
                </controls:SettingsRow>
                <controls:SettingsRow Header="Brightness">
                    <controls:ValueSlider IsEnabled="{Binding IsKeyboardManualLighting}" Minimum="0" Maximum="{Binding SelectedDevice.MaxLightingBrightness}" TickFrequency="5"
                                          Value="{Binding KeyboardLightingBrightness}" Format="{}{0}%"/>
                </controls:SettingsRow>
                <controls:SettingsRow Header="Animation Speed">
                    <ComboBox IsEnabled="{Binding IsKeyboardManualLighting}" SelectedIndex="{Binding KeyboardLightingSpeed, Mode=TwoWay}" MinWidth="240">
                        <ComboBoxItem Content="Slow"/>
                        <ComboBoxItem Content="Normal"/>
                        <ComboBoxItem Content="Fast"/>
                    </ComboBox>
                </controls:SettingsRow>
                <controls:SettingsRow IsEnabled="{Binding IsKeyboardManualLighting}" Header="Colour" Description="Modes that support one or two fixed colors use these values; animated palette modes may choose their own colors.">
                    <controls:SettingsRow.ContentBelow>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Primary color" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,8"/>
                                <controls:ColorSpectrumPicker SelectedColor="{Binding KeyboardPrimaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="170"/>
                                <Border Height="42" Margin="0,8,0,0" CornerRadius="{DynamicResource RadiusControl}" Background="{Binding KeyboardPrimaryBrush}">
                                    <TextBlock Text="{Binding KeyboardPrimaryHex}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Secondary color" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,8"/>
                                <controls:ColorSpectrumPicker SelectedColor="{Binding KeyboardSecondaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="170"/>
                                <Border Height="42" Margin="0,8,0,0" CornerRadius="{DynamicResource RadiusControl}" Background="{Binding KeyboardSecondaryBrush}">
                                    <TextBlock Text="{Binding KeyboardSecondaryHex}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>
                <controls:SettingsGroup.Footer>
                    <ui:Button IsEnabled="{Binding IsKeyboardManualLighting}" Content="Apply lighting" Command="{Binding ApplyKeyboardLightingCommand}"
                               Appearance="Primary" HorizontalAlignment="Right" Icon="{ui:SymbolIcon Save24}"/>
                </controls:SettingsGroup.Footer>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="Onboard profiles" Icon="Stack24"
                                    Description="Switch the hardware profile stored in the selected keyboard."
                                    Visibility="{Binding SelectedDevice.HasProfiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsRow Header="Active profile">
                    <ComboBox ItemsSource="{Binding KeyboardProfileOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding KeyboardProfile, Mode=TwoWay}" MinWidth="240"/>
                </controls:SettingsRow>
                <controls:SettingsGroup.Footer>
                    <ui:Button Content="Switch profile" Command="{Binding SetKeyboardProfileCommand}" CommandParameter="{Binding KeyboardProfile}"
                               Appearance="Primary" HorizontalAlignment="Right" Icon="{ui:SymbolIcon ArrowSync24}"/>
                </controls:SettingsGroup.Footer>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="Wireless power" Icon="BatteryCharge24"
                                    Description="Control idle sleep and the low-battery warning stored by a wireless keyboard."
                                    Visibility="{Binding SelectedDevice.HasKeyboardPower, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsRow Header="Sleep timeout">
                    <ComboBox ItemsSource="{Binding SleepTimeoutOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding DeviceSleepMinutes, Mode=TwoWay}" MinWidth="240"/>
                </controls:SettingsRow>
                <controls:SettingsRow Header="Low-battery warning">
                    <controls:ValueSlider Minimum="0" Maximum="{Binding SelectedDevice.LowBatteryWarningMaximum}"
                                          TickFrequency="{Binding SelectedDevice.LowBatteryWarningStep}" IsSnapToTickEnabled="True"
                                          Value="{Binding KeyboardLowBatteryWarning}" Format="{}{0}%"/>
                </controls:SettingsRow>
                <controls:SettingsGroup.Footer>
                    <ui:Button Content="Apply power settings" Command="{Binding ApplyKeyboardEnergyCommand}"
                               Appearance="Primary" HorizontalAlignment="Right" Icon="{ui:SymbolIcon Save24}"/>
                </controls:SettingsGroup.Footer>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="Keyboard OLED / AMOLED" Icon="Desktop24"
                                    Description="Control the screen built into supported ROG Azoth keyboards."
                                    Visibility="{Binding SelectedDevice.HasKeyboardOled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsRow Header="Display enabled">
                    <ui:ToggleSwitch IsChecked="{Binding KeyboardOledEnabled, Mode=TwoWay}"/>
                </controls:SettingsRow>
                <controls:SettingsRow Header="Brightness">
                    <controls:ValueSlider Minimum="0" Maximum="100" TickFrequency="5"
                                          Value="{Binding KeyboardOledBrightness}" Format="{}{0}%"/>
                </controls:SettingsRow>
                <controls:SettingsRow Header="Lighting Mode">
                    <ComboBox ItemsSource="{Binding KeyboardOledOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding KeyboardOledMode, Mode=TwoWay}" MinWidth="240"/>
                </controls:SettingsRow>
                <controls:SettingsGroup.Footer>
                    <ui:Button Content="Apply display settings" Command="{Binding ApplyKeyboardOledCommand}"
                               Appearance="Primary" HorizontalAlignment="Right" Icon="{ui:SymbolIcon Save24}"/>
                </controls:SettingsGroup.Footer>
            </controls:SettingsGroup>

        </StackPanel>
    </ScrollViewer>
</UserControl>
