<UserControl x:Class="Arsenal.UI.Views.Pages.DisplayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Arsenal.UI.Controls"
>
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel Style="{StaticResource PageBodyStyle}">

            <Grid Style="{StaticResource PageHeaderStyle}">
                <StackPanel>
                    <TextBlock Text="Display &amp; graphics" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Laptop panel, colour pipeline, Optimus and MUX controls" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
            </Grid>

            <controls:SettingsGroup Header="GPU mode" Icon="Glance24"
                                    Description="Choose how the integrated and dedicated GPUs are connected. MUX changes may require a restart.">
                <!-- The chips carry the bare mode names and the description under the
                     label says what the selected one does, which is the arrangement the
                     Home page uses. Four qualified labels - "Eco · iGPU only" and the
                     rest - will not fit in a row's control column beside a label, and
                     they said the same thing twice once the description was there. -->
                <controls:SettingsRow Header="Mode"
                                      Description="{Binding GpuModeDescription}">
                    <WrapPanel Style="{StaticResource RowChoiceGroupStyle}">
                        <RadioButton Style="{DynamicResource RowSegmentStyle}" GroupName="DisplayGpu" Content="Eco"
                                     Visibility="{Binding IsEcoSupported, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     IsChecked="{Binding CurrentGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                     Command="{Binding SetGpuModeCommand}" CommandParameter="0"/>
                        <RadioButton Style="{DynamicResource RowSegmentStyle}" GroupName="DisplayGpu" Content="Standard"
                                     IsChecked="{Binding CurrentGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                     Command="{Binding SetGpuModeCommand}" CommandParameter="1"/>
                        <RadioButton Style="{DynamicResource RowSegmentStyle}" GroupName="DisplayGpu" Content="Ultimate"
                                     Visibility="{Binding IsMuxSupported, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     IsChecked="{Binding CurrentGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                                     Command="{Binding SetGpuModeCommand}" CommandParameter="2"/>
                        <RadioButton Style="{DynamicResource RowSegmentStyle}" GroupName="DisplayGpu" Content="Optimized"
                                     IsChecked="{Binding CurrentGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"
                                     Command="{Binding SetGpuModeCommand}" CommandParameter="3"/>
                    </WrapPanel>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Applications holding the dGPU"
                                      Description="Close them before switching to Eco, or hand the display over to an XG Mobile dock.">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Style="{DynamicResource ActionButtonStyle}" Content="Stop dGPU apps" Command="{Binding StopGpuAppsCommand}" Appearance="Secondary"/>
                        <ui:Button Style="{DynamicResource ActionButtonStyle}" Margin="0" Content="Toggle XG Mobile" Command="{Binding ToggleXgmCommand}" Appearance="Secondary"
                                   Visibility="{Binding IsXgmConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="Panel" Icon="Desktop24"
                                    Description="Refresh rate, resolution and the panel features this model supports.">
                <!-- The buttons write to the ASUS panel only. With the lid shut on a
                     dock, or on "second screen only", that panel is off and the write
                     is a no-op, so the group is disabled and the description says why
                     instead of leaving three live-looking buttons that do nothing. -->
                <controls:SettingsRow Header="Refresh rate"
                                      Description="{Binding RefreshRateDescription}"
                                      Visibility="{Binding IsRefreshRateSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- In the row's control column, not under the text: three short
                         rate chips read as the row's value, and stacking them below the
                         description left the row looking like a heading with a toolbar
                         under it. The Row* variants are the same chips sized for a
                         vertically centred row. -->
                    <WrapPanel Style="{StaticResource RowChoiceGroupStyle}" IsEnabled="{Binding IsInternalPanelActive}">
                        <RadioButton Style="{DynamicResource RowSegmentStyle}" GroupName="RefreshRate"
                                     IsChecked="{Binding IsLowRefreshRate, Mode=OneWay}"
                                     Command="{Binding SetRefreshRateCommand}" CommandParameter="min">
                            <TextBlock Text="{Binding MinRefreshRateLabel}"/>
                        </RadioButton>
                        <RadioButton Style="{DynamicResource RowSegmentStyle}" GroupName="RefreshRate"
                                     IsChecked="{Binding IsMaximumRefreshRate, Mode=OneWay}"
                                     Command="{Binding SetRefreshRateCommand}" CommandParameter="max">
                            <TextBlock Text="{Binding MaxRefreshRateLabel}"/>
                        </RadioButton>
                        <RadioButton Style="{DynamicResource RowSegmentStyle}" GroupName="RefreshRate"
                                     IsChecked="{Binding IsMaximumRefreshRateWithOverdrive, Mode=OneWay}"
                                     Visibility="{Binding IsOverdriveAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Command="{Binding SetRefreshRateCommand}" CommandParameter="max_od">
                            <TextBlock Text="{Binding MaxRefreshRateWithOverdriveLabel}"/>
                        </RadioButton>
                    </WrapPanel>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Connected displays"
                                      Description="What Windows is driving right now. External monitors are set from Windows display settings, not from here."
                                      Visibility="{Binding HasConnectedDisplays, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SettingsRow.ContentBelow>
                        <ItemsControl ItemsSource="{Binding ConnectedDisplays}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SettingLabelStyle}"
                                                       HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SettingDescriptionStyle}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding RefreshRate}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Resolution and HDR"
                                      Description="Switch the panel between its native and scaled modes, or hand HDR back to Windows."
                                      Visibility="{Binding IsPanelModeRowVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Style="{DynamicResource ActionButtonStyle}" Content="Toggle FHD / UHD" Command="{Binding ToggleResolutionCommand}" Appearance="Secondary"
                                   Visibility="{Binding IsResolutionToggleSupported, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ui:Button Style="{DynamicResource ActionButtonStyle}" Margin="0" Content="Toggle HDR control" Command="{Binding ToggleHdrControlCommand}" Appearance="Secondary"
                                   Visibility="{Binding IsHdrControlSupported, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Automatic refresh rate"
                                      Description="Drop to 60 Hz on battery and restore the maximum on AC power.">
                    <ui:ToggleSwitch IsChecked="{Binding IsAutoRefresh, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Mini-LED multi-zone"
                                      Description="Switch between single-zone and multi-zone backlighting."
                                      Visibility="{Binding IsMiniLedSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding IsMiniLed, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Panel brightness"
                                      Description="{Binding PanelBrightnessDescription}">
                    <controls:ValueSlider Minimum="0" Maximum="100" Value="{Binding PanelBrightness}" Format="{}{0}%"
                                          IsEnabled="{Binding IsPanelBrightnessAvailable}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="OLED dimming"
                                      Description="{Binding OledDimmingDescription}"
                                      Visibility="{Binding IsOledPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:ValueSlider Minimum="0" Maximum="100" Value="{Binding Brightness}" Format="{}{0}%"
                                          IsEnabled="{Binding IsOledDimmingAvailable}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="Colour" Icon="Color24"
                                    Description="ASUS GameVisual profile, gamut and white point. These are written to the panel firmware, not to Windows."
                                    Visibility="{Binding HasColorProfiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsRow Header="GameVisual profile">
                    <controls:SettingsRow.ContentBelow>
                        <WrapPanel Style="{StaticResource ChoiceGroupStyle}">
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="Default" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=11}" Command="{Binding SetSplendidCommand}" CommandParameter="11"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="Racing" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=21}" Command="{Binding SetSplendidCommand}" CommandParameter="21"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="Scenery" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=22}" Command="{Binding SetSplendidCommand}" CommandParameter="22"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="RTS / RPG" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=23}" Command="{Binding SetSplendidCommand}" CommandParameter="23"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="FPS" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=24}" Command="{Binding SetSplendidCommand}" CommandParameter="24"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="Cinema" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=25}" Command="{Binding SetSplendidCommand}" CommandParameter="25"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="Vivid" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=13}" Command="{Binding SetSplendidCommand}" CommandParameter="13"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="Eyecare" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=17}" Command="{Binding SetSplendidCommand}" CommandParameter="17"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="E-Reading" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=212}" Command="{Binding SetSplendidCommand}" CommandParameter="212"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="Disabled" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=18}" Command="{Binding SetSplendidCommand}" CommandParameter="18"/>
                        </WrapPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="Colour gamut" IsEnabled="{Binding IsColorPipelineEnabled}">
                    <controls:SettingsRow.ContentBelow>
                        <WrapPanel Style="{StaticResource ChoiceGroupStyle}">
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="Gamut" Content="Native" IsChecked="{Binding SelectedGamut, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=50}" Command="{Binding SetGamutCommand}" CommandParameter="50"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="Gamut" Content="sRGB" IsChecked="{Binding SelectedGamut, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=51}" Command="{Binding SetGamutCommand}" CommandParameter="51"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="Gamut" Content="DCI-P3" IsChecked="{Binding SelectedGamut, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=53}" Command="{Binding SetGamutCommand}" CommandParameter="53"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="Gamut" Content="Display P3" IsChecked="{Binding SelectedGamut, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=54}" Command="{Binding SetGamutCommand}" CommandParameter="54"/>
                        </WrapPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="White point" IsEnabled="{Binding IsColorPipelineEnabled}">
                    <controls:SettingsRow.ContentBelow>
                        <WrapPanel Style="{StaticResource ChoiceGroupStyle}">
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="WhitePoint" Content="Warmest" IsChecked="{Binding ColorTemperature, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}" Command="{Binding SetColorTemperatureValueCommand}" CommandParameter="0"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="WhitePoint" Content="Warmer" IsChecked="{Binding ColorTemperature, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=15}" Command="{Binding SetColorTemperatureValueCommand}" CommandParameter="15"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="WhitePoint" Content="Warm" IsChecked="{Binding ColorTemperature, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=30}" Command="{Binding SetColorTemperatureValueCommand}" CommandParameter="30"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="WhitePoint" Content="Neutral" IsChecked="{Binding ColorTemperature, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=50}" Command="{Binding SetColorTemperatureValueCommand}" CommandParameter="50"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="WhitePoint" Content="Cold" IsChecked="{Binding ColorTemperature, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=70}" Command="{Binding SetColorTemperatureValueCommand}" CommandParameter="70"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="WhitePoint" Content="Colder" IsChecked="{Binding ColorTemperature, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=85}" Command="{Binding SetColorTemperatureValueCommand}" CommandParameter="85"/>
                            <RadioButton Style="{DynamicResource SegmentedRadioButtonStyle}" GroupName="WhitePoint" Content="Coldest" IsChecked="{Binding ColorTemperature, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=100}" Command="{Binding SetColorTemperatureValueCommand}" CommandParameter="100"/>
                        </WrapPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="Colour profiles" Icon="DocumentBulletList24"
                                    Description="The ICC profiles ASUS ships for this panel, and installing them for Windows to use.">
                <controls:SettingsRow Header="ASUS ICC profiles" Description="{Binding ColorProfileStatus}">
                    <ui:Button Content="Install profiles" Command="{Binding InstallColorProfilesCommand}" Appearance="Secondary"
                               Visibility="{Binding CanInstallColorProfiles, Converter={StaticResource BooleanToVisibilityConverter}}"
                               IsEnabled="{Binding IsInstallingProfiles, Converter={StaticResource InverseBoolConverter}}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

        </StackPanel>
    </ScrollViewer>
</UserControl>
