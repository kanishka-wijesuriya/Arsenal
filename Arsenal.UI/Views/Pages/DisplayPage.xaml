<UserControl x:Class="Arsenal.UI.Views.Pages.DisplayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Arsenal.UI.Controls"
             xmlns:loc="clr-namespace:Arsenal.UI.Markup">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel Style="{StaticResource PageBodyStyle}">

            <Grid Style="{StaticResource PageHeaderStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc DisplayDisplayGraphics}" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="{loc:Loc DisplayLaptopPanelColourPipelineOptimus}" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
            </Grid>

            <controls:SettingsGroup Header="{loc:Loc DisplayGPUMode}" Icon="Glance24"
                                    Description="{loc:Loc DisplayChooseHowTheIntegratedAnd}">
                <!-- The chips carry the bare mode names and the description under the
                     label says what the selected one does, which is the arrangement the
                     Home page uses. Four qualified labels - "Eco · iGPU only" and the
                     rest - will not fit in a row's control column beside a label, and
                     they said the same thing twice once the description was there. -->
                <controls:SettingsRow Header="{loc:Loc PerformanceMode}"
                                      Description="{Binding GpuModeDescription}">
                    <WrapPanel Style="{StaticResource RowChoiceGroupStyle}">
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="DisplayGpu" Content="{loc:Loc EcoMode}"
                                     Visibility="{Binding IsEcoSupported, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     IsChecked="{Binding CurrentGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"
                                     Command="{Binding SetGpuModeCommand}" CommandParameter="0"/>
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="DisplayGpu" Content="{loc:Loc StandardMode}"
                                     IsChecked="{Binding CurrentGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"
                                     Command="{Binding SetGpuModeCommand}" CommandParameter="1"/>
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="DisplayGpu" Content="{loc:Loc UltimateMode}"
                                     Visibility="{Binding IsMuxSupported, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     IsChecked="{Binding CurrentGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"
                                     Command="{Binding SetGpuModeCommand}" CommandParameter="2"/>
                        <RadioButton Style="{StaticResource RowSegmentStyle}" GroupName="DisplayGpu" Content="{loc:Loc Optimized}"
                                     IsChecked="{Binding CurrentGpuMode, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"
                                     Command="{Binding SetGpuModeCommand}" CommandParameter="3"/>
                    </WrapPanel>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc DisplayApplicationsHoldingTheDGPU}"
                                      Description="{loc:Loc DisplayCloseThemBeforeSwitchingTo}">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Style="{StaticResource ActionButtonStyle}" Content="{loc:Loc DisplayStopDGPUApps}" Command="{Binding StopGpuAppsCommand}" Appearance="Secondary"/>
                        <ui:Button Style="{StaticResource ActionButtonStyle}" Margin="0" Content="{loc:Loc DisplayToggleXGMobile}" Command="{Binding ToggleXgmCommand}" Appearance="Secondary"
                                   Visibility="{Binding IsXgmConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc DisplayPanel}" Icon="Desktop24"
                                    Description="{loc:Loc DisplayRefreshRateResolutionAndThe}">
                <controls:SettingsRow Header="{loc:Loc DisplayRefreshRate}"
                                      Visibility="{Binding IsRefreshRateSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SettingsRow.ContentBelow>
                        <WrapPanel Style="{StaticResource ChoiceGroupStyle}">
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="RefreshRate"
                                         IsChecked="{Binding IsLowRefreshRate, Mode=OneWay}"
                                         Command="{Binding SetRefreshRateCommand}" CommandParameter="min">
                                <TextBlock Text="{Binding MinRefreshRateLabel}"/>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="RefreshRate"
                                         IsChecked="{Binding IsMaximumRefreshRate, Mode=OneWay}"
                                         Command="{Binding SetRefreshRateCommand}" CommandParameter="max">
                                <TextBlock Text="{Binding MaxRefreshRateLabel}"/>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="RefreshRate"
                                         IsChecked="{Binding IsMaximumRefreshRateWithOverdrive, Mode=OneWay}"
                                         Visibility="{Binding IsOverdriveAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Command="{Binding SetRefreshRateCommand}" CommandParameter="max_od">
                                <TextBlock Text="{Binding MaxRefreshRateWithOverdriveLabel}"/>
                            </RadioButton>
                        </WrapPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc DisplayResolutionAndHDR}"
                                      Description="{loc:Loc DisplaySwitchThePanelBetweenIts}"
                                      Visibility="{Binding IsPanelModeRowVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Style="{StaticResource ActionButtonStyle}" Content="{loc:Loc DisplayToggleFHDUHD}" Command="{Binding ToggleResolutionCommand}" Appearance="Secondary"
                                   Visibility="{Binding IsResolutionToggleSupported, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ui:Button Style="{StaticResource ActionButtonStyle}" Margin="0" Content="{loc:Loc DisplayToggleHDRControl}" Command="{Binding ToggleHdrControlCommand}" Appearance="Secondary"
                                   Visibility="{Binding IsHdrControlSupported, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc DisplayAutomaticRefreshRate}"
                                      Description="{loc:Loc DisplayDropTo60HzOn}">
                    <ui:ToggleSwitch IsChecked="{Binding IsAutoRefresh, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc DisplayMiniLEDMultiZone}"
                                      Description="{loc:Loc DisplaySwitchBetweenSingleZoneAnd}"
                                      Visibility="{Binding IsMiniLedSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ToggleSwitch IsChecked="{Binding IsMiniLed, Mode=TwoWay}"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc DisplayPanelBrightness}"
                                      Description="{loc:Loc DisplayTheDisplayBacklightTheSame}">
                    <controls:ValueSlider Minimum="0" Maximum="100" Value="{Binding PanelBrightness}" Format="{}{0}%"/>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc DisplayOLEDDimming}"
                                      Description="{loc:Loc DisplaySoftwareDimmingAppliedByThe}"
                                      Visibility="{Binding IsOledPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:ValueSlider Minimum="0" Maximum="100" Value="{Binding Brightness}" Format="{}{0}%"
                                          IsEnabled="{Binding IsOledDimmingAvailable}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc DisplayColour}" Icon="Color24"
                                    Description="{loc:Loc DisplayASUSGameVisualProfileGamutAnd}"
                                    Visibility="{Binding HasColorProfiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SettingsRow Header="{loc:Loc DisplayGameVisualProfile}">
                    <controls:SettingsRow.ContentBelow>
                        <WrapPanel Style="{StaticResource ChoiceGroupStyle}">
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="{loc:Loc Default}" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=11}" Command="{Binding SetSplendidCommand}" CommandParameter="11"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="{loc:Loc DisplayRacing}" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=21}" Command="{Binding SetSplendidCommand}" CommandParameter="21"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="{loc:Loc DisplayScenery}" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=22}" Command="{Binding SetSplendidCommand}" CommandParameter="22"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="{loc:Loc DisplayRTSRPG}" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=23}" Command="{Binding SetSplendidCommand}" CommandParameter="23"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="{loc:Loc DisplayFPS}" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=24}" Command="{Binding SetSplendidCommand}" CommandParameter="24"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="{loc:Loc DisplayCinema}" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=25}" Command="{Binding SetSplendidCommand}" CommandParameter="25"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="{loc:Loc DisplayVivid}" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=13}" Command="{Binding SetSplendidCommand}" CommandParameter="13"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="{loc:Loc DisplayEyecare}" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=17}" Command="{Binding SetSplendidCommand}" CommandParameter="17"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="{loc:Loc DisplayEReading}" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=212}" Command="{Binding SetSplendidCommand}" CommandParameter="212"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="Splendid" Content="{loc:Loc DisplayDisabled}" IsChecked="{Binding SelectedSplendidProfile, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=18}" Command="{Binding SetSplendidCommand}" CommandParameter="18"/>
                        </WrapPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc DisplayColourGamut}" IsEnabled="{Binding IsColorPipelineEnabled}">
                    <controls:SettingsRow.ContentBelow>
                        <WrapPanel Style="{StaticResource ChoiceGroupStyle}">
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="Gamut" Content="{loc:Loc DisplayNative}" IsChecked="{Binding SelectedGamut, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=50}" Command="{Binding SetGamutCommand}" CommandParameter="50"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="Gamut" Content="{loc:Loc DisplaySRGB}" IsChecked="{Binding SelectedGamut, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=51}" Command="{Binding SetGamutCommand}" CommandParameter="51"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="Gamut" Content="{loc:Loc DisplayDCIP3}" IsChecked="{Binding SelectedGamut, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=53}" Command="{Binding SetGamutCommand}" CommandParameter="53"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="Gamut" Content="{loc:Loc DisplayDisplayP3}" IsChecked="{Binding SelectedGamut, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=54}" Command="{Binding SetGamutCommand}" CommandParameter="54"/>
                        </WrapPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>

                <controls:SettingsRow Header="{loc:Loc DisplayWhitePoint}" IsEnabled="{Binding IsColorPipelineEnabled}">
                    <controls:SettingsRow.ContentBelow>
                        <WrapPanel Style="{StaticResource ChoiceGroupStyle}">
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="WhitePoint" Content="{loc:Loc DisplayWarmest}" IsChecked="{Binding ColorTemperature, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}" Command="{Binding SetColorTemperatureValueCommand}" CommandParameter="0"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="WhitePoint" Content="{loc:Loc DisplayWarmer}" IsChecked="{Binding ColorTemperature, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=15}" Command="{Binding SetColorTemperatureValueCommand}" CommandParameter="15"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="WhitePoint" Content="{loc:Loc DisplayWarm}" IsChecked="{Binding ColorTemperature, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=30}" Command="{Binding SetColorTemperatureValueCommand}" CommandParameter="30"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="WhitePoint" Content="{loc:Loc DisplayNeutral}" IsChecked="{Binding ColorTemperature, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=50}" Command="{Binding SetColorTemperatureValueCommand}" CommandParameter="50"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="WhitePoint" Content="{loc:Loc DisplayCold}" IsChecked="{Binding ColorTemperature, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=70}" Command="{Binding SetColorTemperatureValueCommand}" CommandParameter="70"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="WhitePoint" Content="{loc:Loc DisplayColder}" IsChecked="{Binding ColorTemperature, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=85}" Command="{Binding SetColorTemperatureValueCommand}" CommandParameter="85"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="WhitePoint" Content="{loc:Loc DisplayColdest}" IsChecked="{Binding ColorTemperature, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=100}" Command="{Binding SetColorTemperatureValueCommand}" CommandParameter="100"/>
                        </WrapPanel>
                    </controls:SettingsRow.ContentBelow>
                </controls:SettingsRow>
            </controls:SettingsGroup>

            <controls:SettingsGroup Header="{loc:Loc DisplayColourProfiles}" Icon="DocumentBulletList24">
                <controls:SettingsRow Header="{loc:Loc DisplayASUSICCProfiles}" Description="{Binding ColorProfileStatus}">
                    <ui:Button Content="{loc:Loc DisplayInstallProfiles}" Command="{Binding InstallColorProfilesCommand}" Appearance="Secondary"
                               Visibility="{Binding CanInstallColorProfiles, Converter={StaticResource BooleanToVisibilityConverter}}"
                               IsEnabled="{Binding IsInstallingProfiles, Converter={StaticResource InverseBoolConverter}}"/>
                </controls:SettingsRow>
            </controls:SettingsGroup>

        </StackPanel>
    </ScrollViewer>
</UserControl>
