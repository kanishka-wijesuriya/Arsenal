<UserControl x:Class="Arsenal.UI.Views.Overlays.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="620">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TextBox x:Name="SearchBox"
                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Search settings and commands: try Eco, 80%, Turbo or Fan"
                    Icon="{ui:SymbolIcon Search24}"
                    FontSize="15"
                    Padding="12,10"
                    Margin="0,0,0,12"
                    PreviewKeyDown="SearchBox_PreviewKeyDown"/>

        <!-- Height is bounded so the panel does not grow to the full overlay on a broad
             query; the list scrolls inside instead. -->
        <ListBox x:Name="ResultsList"
                 Grid.Row="1"
                 MaxHeight="380"
                 ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedItem}"
                 MouseDoubleClick="ResultsList_MouseDoubleClick"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0,0,6,0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,8" MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SettingLabelStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource SettingDescriptionStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{DynamicResource SurfaceCardHover}"
                                BorderBrush="{DynamicResource StrokeSubtle}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1"
                   Text="No matches. Try a shorter word."
                   Style="{StaticResource CaptionStyle}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <TextBlock Grid.Row="2" Margin="10,10,0,0" Style="{StaticResource CaptionStyle}"
                   Text="↑ ↓ to move · Enter to run · Esc to close"/>
    </Grid>
</UserControl>
