<Project>

  <!--
    The version, in one place.

    It used to live in Arsenal.UI.csproj and Arsenal.Core.csproj, duplicated, while
    Arsenal.Application declared none at all and therefore stamped 1.0.0.0 forever.
    The written rule named only the first two projects, so it had the same gap.
    Every project now inherits from here, and there is one line to change when
    releasing. CONTRIBUTING.md documents the rule.

    AssemblyVersion and FileVersion stay numeric. A pre-release label belongs only in
    InformationalVersion, which is what the About page reads and what
    ReleaseVersion.CurrentString parses.

    A test build keeps the latest stable numeric version. The sibling release folder uses
    a t suffix (for example, 1.1.4t-monitor-hotplug), but the assembly remains 1.1.4.
    Only an explicitly requested stable release changes the values below.

    A folder name is never evidence of a binary version. Verify the stamp directly:

        (Get-Item Arsenal.exe).VersionInfo.ProductVersion

    Multiple same-version tests are distinguished by their descriptive folder slug.
  -->

  <PropertyGroup>
    <Version>1.1.4</Version>
    <AssemblyVersion>1.1.4.0</AssemblyVersion>
    <FileVersion>1.1.4.0</FileVersion>
    <InformationalVersion>1.1.4</InformationalVersion>

    <!--
      Now that the project is in a repository, the SDK appends "+<commit sha>" to
      InformationalVersion, and that is what ProductVersion reports. Release validation
      compares ProductVersion with the numeric stable base, so the generated source
      revision suffix is disabled.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Store packages are updated by Microsoft Store. The symbol is inherited by
       every project so no portable self-update path can be reached accidentally. -->
  <PropertyGroup Condition="'$(ArsenalStoreBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);ARSENAL_STORE</DefineConstants>
  </PropertyGroup>

</Project>
